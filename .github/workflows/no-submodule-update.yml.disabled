name: No submodule update checker

# Проверка отключена: workflow оставлен валидным no-op,
# чтобы GitHub Actions не падал на пустом/закомментированном YAML.

on:
  pull_request:
    paths:
      - 'RobustToolbox'
      - '.github/workflows/no-submodule-update.yml'

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  checker-disabled:
    name: Submodule update check (disabled)
    runs-on: ubuntu-latest
    steps:
      - name: Skip
        run: echo "Submodule update checker is disabled; review RobustToolbox changes manually if present."
