+using Content.Shared.Anomaly.Components;
+using Content.Shared.Database;
+using Content.Shared.Mobs;
+using Content.Shared.Mobs.Components;
+using Robust.Shared.Map;
+using Robust.Shared.Spawners;
+
+namespace Content.Server._Fish.Research.Bluespace;
+
+public sealed partial class FishBluespaceHarvesterSystem
+{
+    // Fish-edit: волны существ и аномалии используют отдельные таймеры и общий запрет вложенного спавна на станции.
+    [Dependency] private EntityQuery<MobStateComponent> _mobStateQuery = default!;
+    [Dependency] private EntityQuery<AnomalyComponent> _anomalyQuery = default!;
+
+    private const int MaximumActiveIncursions = 6;
+    private const int MaximumActiveAnomalies = 2;
+
+    /// <summary>Releases a bounded hostile wave within the shared station cooldown and living creature budget.</summary>
+    public bool TryOpenIncursion(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        if (!CanOpenIncursion(ent, out var station, out var coordinates))
+            return false;
+
+        var incidents = EnsureComp<FishBluespaceHarvesterStationComponent>(station);
+        incidents.Incursions.RemoveWhere(uid => !IsActiveIncursion(uid));
+        var waveSize = _bluespaceBackground.HasAnomalyRisk(ent) ? ent.Comp.DangerousWaveSize : ent.Comp.IncursionWaveSize;
+        var count = Math.Min(Math.Clamp(waveSize, 1, MaximumActiveIncursions),
+            Math.Min(ent.Comp.MaxActiveIncursions, MaximumActiveIncursions) - incidents.Incursions.Count);
+        incidents.Spawning = true;
+        incidents.NextIncident = _timing.CurTime + TimeSpan.FromSeconds(
+            Math.Clamp(ent.Comp.IncidentCooldown.TotalSeconds, 40d, 600d));
+        try
+        {
+            var rift = Spawn(ent.Comp.RiftPrototype, coordinates);
+            if (!TerminatingOrDeleted(rift))
+                EnsureComp<TimedDespawnComponent>(rift).Lifetime = 10f;
+
+            for (var i = 0; i < count; i++)
+            {
+                // Fish-edit: каждый Spawn может сменить станцию, остановить установку или удалить выходной тайл.
+                if (!CanContinueIncident(ent, station) || !_bluespaceBackground.HasIncursionRisk(ent) ||
+                    !IsSafeOutput(ent, coordinates))
+                    break;
+
+                var creature = Spawn(ent.Comp.HostilePrototype, coordinates);
+                if (TerminatingOrDeleted(creature))
+                    continue;
+
+                incidents.Incursions.Add(creature);
+                EnsureComp<TimedDespawnComponent>(creature).Lifetime = (float) Math.Clamp(
+                    ent.Comp.IncursionLifetime.TotalSeconds, 1d, 180d);
+                _adminLog.Add(LogType.Action, LogImpact.High,
+                    $"{ToPrettyString(ent)} opened a bluespace incursion on {ToPrettyString(station)}, releasing {ToPrettyString(creature)}.");
+            }
+        }
+        finally
+        {
+            incidents.Spawning = false;
+        }
+
+        return true;
+    }
+
+    /// <summary>Checks operation, prototypes, safe output and station limits without reserving a wave.</summary>
+    public bool CanOpenIncursion(Entity<FishBluespaceHarvesterComponent> ent,
+        out EntityUid station, out EntityCoordinates coordinates)
+    {
+        station = default;
+        coordinates = default;
+        if (!CanOperate(ent) || !_bluespaceBackground.HasIncursionRisk(ent) ||
+            !_bluespaceBackground.TryGetScope(ent, out station) ||
+            !_prototype.TryIndex(ent.Comp.RiftPrototype, out var rift) || rift.Abstract ||
+            !_prototype.TryIndex(ent.Comp.HostilePrototype, out var hostile) || hostile.Abstract ||
+            ent.Comp.MaxActiveIncursions <= 0)
+            return false;
+
+        if (TryComp<FishBluespaceHarvesterStationComponent>(station, out var incidents))
+        {
+            if (incidents.Spawning || _timing.CurTime < incidents.NextIncident)
+                return false;
+
+            var count = 0;
+            foreach (var creature in incidents.Incursions)
+            {
+                if (IsActiveIncursion(creature) && ++count >= Math.Min(ent.Comp.MaxActiveIncursions, MaximumActiveIncursions))
+                    return false;
+            }
+        }
+
+        return TryGetOutput(ent, out coordinates);
+    }
+
+    /// <summary>Creates a native anomaly which must be handled normally instead of despawning on a timer.</summary>
+    public bool TrySpawnAnomaly(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        if (!CanSpawnAnomaly(ent, out var station, out var coordinates))
+            return false;
+
+        var incidents = EnsureComp<FishBluespaceHarvesterStationComponent>(station);
+        incidents.Anomalies.RemoveWhere(uid => !IsActiveAnomaly(uid));
+        incidents.Spawning = true;
+        incidents.NextAnomaly = _timing.CurTime + TimeSpan.FromSeconds(
+            Math.Clamp(ent.Comp.AnomalyCooldown.TotalSeconds, 120d, 3600d));
+        try
+        {
+            var anomaly = Spawn(ent.Comp.AnomalyPrototype, coordinates);
+            if (IsActiveAnomaly(anomaly))
+                incidents.Anomalies.Add(anomaly);
+
+            _adminLog.Add(LogType.Anomaly, LogImpact.High,
+                $"{ToPrettyString(ent)} created bluespace anomaly {ToPrettyString(anomaly)} on {ToPrettyString(station)}.");
+        }
+        finally
+        {
+            incidents.Spawning = false;
+        }
+
+        return true;
+    }
+
+    /// <summary>Checks the separate station anomaly cooldown and active anomaly budget without changing either.</summary>
+    public bool CanSpawnAnomaly(Entity<FishBluespaceHarvesterComponent> ent,
+        out EntityUid station, out EntityCoordinates coordinates)
+    {
+        station = default;
+        coordinates = default;
+        if (!CanOperate(ent) || !_bluespaceBackground.HasAnomalyRisk(ent) ||
+            !_bluespaceBackground.TryGetScope(ent, out station) || ent.Comp.MaxActiveAnomalies <= 0 ||
+            !_prototype.TryIndex(ent.Comp.AnomalyPrototype, out var anomaly) || anomaly.Abstract ||
+            !anomaly.Components.ContainsKey("Anomaly"))
+            return false;
+
+        if (TryComp<FishBluespaceHarvesterStationComponent>(station, out var incidents))
+        {
+            if (incidents.Spawning || _timing.CurTime < incidents.NextAnomaly)
+                return false;
+
+            var count = 0;
+            foreach (var active in incidents.Anomalies)
+            {
+                if (IsActiveAnomaly(active) && ++count >= Math.Min(ent.Comp.MaxActiveAnomalies, MaximumActiveAnomalies))
+                    return false;
+            }
+        }
+
+        return TryGetOutput(ent, out coordinates, incidents?.Anomalies);
+    }
+
+    private bool IsAnomalyOutputOccupied(EntityCoordinates coordinates, HashSet<EntityUid>? anomalies)
+    {
+        if (anomalies == null)
+            return false;
+
+        foreach (var anomaly in anomalies)
+        {
+            if (IsActiveAnomaly(anomaly) && _transformQuery.TryComp(anomaly, out var transform) &&
+                _transform.InRange(coordinates, transform.Coordinates, 1f))
+                return true;
+        }
+
+        return false;
+    }
+
+    private bool CanContinueIncident(Entity<FishBluespaceHarvesterComponent> ent, EntityUid station)
+    {
+        return CanOperate(ent) && _bluespaceBackground.TryGetScope(ent, out var currentStation) && currentStation == station;
+    }
+
+    private bool IsActiveIncursion(EntityUid creature)
+    {
+        return !TerminatingOrDeleted(creature) &&
+               (!_mobStateQuery.TryComp(creature, out var mobState) || mobState.CurrentState != MobState.Dead);
+    }
+
+    private bool IsActiveAnomaly(EntityUid anomaly)
+    {
+        return !TerminatingOrDeleted(anomaly) && _anomalyQuery.HasComp(anomaly);
+    }
+}
diff --git a/Content.Server/_Fish/Research/Bluespace/FishBluespaceHarvesterSystem.Production.cs b/Content.Server/_Fish/Research/Bluespace/FishBluespaceHarvesterSystem.Production.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a00562547937170a4186801495a9d77155e7b98e
--- /dev/null
+++ b/Content.Server/_Fish/Research/Bluespace/FishBluespaceHarvesterSystem.Production.cs
@@ -0,0 +1,165 @@
+using Content.Shared._Fish.Research.Bluespace;
+using Content.Shared.Database;
+using Content.Shared.Physics;
+using Robust.Shared.Map;
+
+namespace Content.Server._Fish.Research.Bluespace;
+
+public sealed partial class FishBluespaceHarvesterSystem
+{
+    // Fish-edit: партия расходует заряд до первого Spawn, а инциденты резервируют общий бюджет станции.
+    /// <summary>Claims one completed reward before spawning a bounded, weighted batch on safe floor.</summary>
+    public bool TryProduceReward(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        if (!CanProduceReward(ent, out var coordinates))
+        {
+            if (!ent.Comp.Producing && CanOperate(ent) && ent.Comp.StoredEnergy >= ent.Comp.EnergyPerReward)
+                ent.Comp.OutputBlocked = true;
+            return false;
+        }
+
+        var reward = PickLoot(ent.Comp.LootCategory);
+        if (reward == null)
+            return false;
+
+        ent.Comp.Producing = true;
+        ent.Comp.StoredEnergy = 0d;
+        ent.Comp.OutputBlocked = false;
+        try
+        {
+            _adminLog.Add(LogType.Action, LogImpact.Low,
+                $"{ToPrettyString(ent)} claimed bluespace harvester reward {reward.ID} at {coordinates}.");
+            var spawnedEntities = 0;
+            foreach (var (product, count) in reward.Products)
+            {
+                var remaining = count;
+                while (remaining > 0)
+                {
+                    // Fish-edit: каждый Spawn может вызвать вложенные события и изменить допустимость выхода.
+                    if (spawnedEntities >= MaximumBatchSize || !CanOperate(ent) || !IsSafeOutput(ent, coordinates))
+                        return true;
+
+                    var maxCount = _stack.GetMaxCount(product);
+                    if (maxCount <= 0)
+                        return true;
+
+                    // Fish-edit: количество задаётся в единицах, а каждый вызов создаёт одну штатную стопку.
+                    var units = Math.Min(remaining, maxCount);
+                    remaining -= units;
+                    spawnedEntities++;
+                    _stack.SpawnMultipleAtPosition(product, units, coordinates);
+                }
+            }
+        }
+        finally
+        {
+            ent.Comp.Producing = false;
+        }
+
+        return true;
+    }
+
+    /// <summary>Checks real operation, a complete charge, a valid reward table and safe floor outside the footprint.</summary>
+    public bool CanProduceReward(Entity<FishBluespaceHarvesterComponent> ent, out EntityCoordinates coordinates)
+    {
+        coordinates = default;
+        return !ent.Comp.Producing && CanOperate(ent) && double.IsFinite(ent.Comp.StoredEnergy) &&
+               ent.Comp.StoredEnergy >= ent.Comp.EnergyPerReward &&
+               GetTotalLootWeight(ent.Comp.LootCategory) > 0d && TryGetOutput(ent, out coordinates);
+    }
+
+    private double GetTotalLootWeight(FishBluespaceLootCategory category)
+    {
+        var total = 0d;
+        foreach (var reward in _prototype.EnumeratePrototypes<FishBluespaceHarvesterLootPrototype>())
+        {
+            if (reward.Category == category && IsValidLoot(reward))
+                total += reward.Weight;
+        }
+
+        return double.IsFinite(total) ? total : 0d;
+    }
+
+    private FishBluespaceHarvesterLootPrototype? PickLoot(FishBluespaceLootCategory category)
+    {
+        var total = GetTotalLootWeight(category);
+        if (total <= 0d)
+            return null;
+
+        var roll = _random.NextDouble() * total;
+        FishBluespaceHarvesterLootPrototype? last = null;
+        foreach (var reward in _prototype.EnumeratePrototypes<FishBluespaceHarvesterLootPrototype>())
+        {
+            if (reward.Category != category || !IsValidLoot(reward))
+                continue;
+
+            last = reward;
+            roll -= reward.Weight;
+            if (roll < 0d)
+                return reward;
+        }
+
+        return last;
+    }
+
+    private bool IsValidLoot(FishBluespaceHarvesterLootPrototype reward)
+    {
+        if (!float.IsFinite(reward.Weight) || reward.Weight <= 0f || reward.Products.Count == 0 ||
+            reward.Products.Count > MaximumBatchSize)
+            return false;
+
+        var totalUnits = 0;
+        var totalEntities = 0;
+        foreach (var (product, count) in reward.Products)
+        {
+            if (count <= 0 || count > MaximumBatchUnits ||
+                !_prototype.TryIndex(product, out var prototype) || prototype.Abstract)
+                return false;
+
+            var maxCount = _stack.GetMaxCount(prototype);
+            if (maxCount <= 0)
+                return false;
+
+            totalUnits += count;
+            totalEntities += 1 + (count - 1) / maxCount;
+            if (totalUnits > MaximumBatchUnits || totalEntities > MaximumBatchSize)
+                return false;
+        }
+
+        return true;
+    }
+
+    private bool TryGetOutput(Entity<FishBluespaceHarvesterComponent> ent, out EntityCoordinates coordinates,
+        HashSet<EntityUid>? anomalies = null)
+    {
+        coordinates = default;
+        if (!IsOnWorldFloor(ent) || !_transformQuery.TryComp(ent, out var xform) ||
+            xform.GridUid is not { } grid || !_gridQuery.TryComp(grid, out var mapGrid) ||
+            !_transform.TryGetGridTilePosition((ent.Owner, xform), out var origin, mapGrid))
+            return false;
+
+        foreach (var offset in OutputOffsets)
+        {
+            var candidate = _map.GridTileToLocal(grid, mapGrid, origin + offset);
+            if (!IsSafeOutput(ent, candidate) || IsAnomalyOutputOccupied(candidate, anomalies))
+                continue;
+
+            coordinates = candidate;
+            return true;
+        }
+
+        return false;
+    }
+
+    private bool IsSafeOutput(Entity<FishBluespaceHarvesterComponent> ent, EntityCoordinates coordinates)
+    {
+        if (!_transformQuery.TryComp(ent, out var xform) || xform.GridUid != coordinates.EntityId ||
+            !_bluespaceBackground.TryGetScope(ent, out var station) ||
+            !_bluespaceBackground.TryGetScope(coordinates.EntityId, out var outputStation) || outputStation != station ||
+            _turf.GetTileRef(coordinates) is not { } tile || tile.GridUid != coordinates.EntityId ||
+            _turf.IsSpace(tile) || _turf.IsTileBlocked(tile, CollisionGroup.FullTileMask, 0f))
+            return false;
+
+        return _interaction.InRangeUnobstructed(ent.Owner, _transform.ToMapCoordinates(coordinates), 3.5f);
+    }
+}
diff --git a/Content.Server/_Fish/Research/Bluespace/FishBluespaceHarvesterSystem.cs b/Content.Server/_Fish/Research/Bluespace/FishBluespaceHarvesterSystem.cs
new file mode 100644
index 0000000000000000000000000000000000000000..2cfbc4c40b78d3a6a6c09089d4298e92095aaf63
--- /dev/null
+++ b/Content.Server/_Fish/Research/Bluespace/FishBluespaceHarvesterSystem.cs
@@ -0,0 +1,260 @@
+using Content.Server.Power.Components;
+using Content.Server.Power.EntitySystems;
+using Content.Server.Stack;
+using Content.Shared._Fish.Research.Bluespace;
+using Content.Shared.ActionBlocker;
+using Content.Shared.Administration.Logs;
+using Content.Shared.Interaction;
+using Content.Shared.Maps;
+using Content.Shared.Power.Components;
+using Robust.Shared.Containers;
+using Robust.Shared.Map;
+using Robust.Shared.Map.Components;
+using Robust.Shared.Prototypes;
+using Robust.Shared.Random;
+using Robust.Shared.Timing;
+
+namespace Content.Server._Fish.Research.Bluespace;
+
+/// <summary>Converts real HV energy into bounded rewards while sharing station bluespace instability.</summary>
+public sealed partial class FishBluespaceHarvesterSystem : EntitySystem
+{
+    [Dependency] private FishBluespaceBackgroundSystem _bluespaceBackground = default!;
+    [Dependency] private PowerStateSystem _powerState = default!;
+    [Dependency] private StackSystem _stack = default!;
+    [Dependency] private SharedContainerSystem _container = default!;
+    [Dependency] private SharedTransformSystem _transform = default!;
+    [Dependency] private SharedMapSystem _map = default!;
+    [Dependency] private TurfSystem _turf = default!;
+    [Dependency] private SharedAppearanceSystem _appearance = default!;
+    [Dependency] private SharedUserInterfaceSystem _ui = default!;
+    [Dependency] private SharedInteractionSystem _interaction = default!;
+    [Dependency] private ActionBlockerSystem _actionBlocker = default!;
+    [Dependency] private ISharedAdminLogManager _adminLog = default!;
+    [Dependency] private IPrototypeManager _prototype = default!;
+    [Dependency] private IRobustRandom _random = default!;
+    [Dependency] private IGameTiming _timing = default!;
+    [Dependency] private EntityQuery<PowerConsumerComponent> _powerConsumerQuery = default!;
+    [Dependency] private EntityQuery<PowerStateComponent> _powerStateQuery = default!;
+    [Dependency] private EntityQuery<TransformComponent> _transformQuery = default!;
+    [Dependency] private EntityQuery<MetaDataComponent> _metaQuery = default!;
+    [Dependency] private EntityQuery<MapGridComponent> _gridQuery = default!;
+
+    private const int MaximumBatchSize = 16;
+    private const int MaximumBatchUnits = 300;
+    private static readonly TimeSpan CheckInterval = TimeSpan.FromSeconds(1);
+    private static readonly Vector2i[] OutputOffsets =
+    [
+        new(0, -2), new(2, 0), new(0, 2), new(-2, 0),
+        new(0, -3), new(3, 0), new(0, 3), new(-3, 0),
+    ];
+
+    /// <inheritdoc/>
+    public override void Initialize()
+    {
+        base.Initialize();
+        UpdatesAfter.Add(typeof(PowerNetSystem));
+        UpdatesAfter.Add(typeof(FishBluespaceBackgroundSystem));
+        SubscribeLocalEvent<FishBluespaceHarvesterComponent, MapInitEvent>(OnMapInit);
+        SubscribeLocalEvent<FishBluespaceHarvesterComponent, ComponentShutdown>(OnShutdown);
+        SubscribeLocalEvent<FishBluespaceHarvesterComponent, EntityPausedEvent>(OnPaused);
+        SubscribeLocalEvent<FishBluespaceHarvesterComponent, AnchorStateChangedEvent>(OnAnchorChanged);
+        SubscribeLocalEvent<FishBluespaceHarvesterComponent, EntGotInsertedIntoContainerMessage>(OnInserted);
+
+        Subs.BuiEvents<FishBluespaceHarvesterComponent>(FishBluespaceDeviceUiKey.Key, subs =>
+        {
+            subs.Event<BoundUIOpenedEvent>(OnUiOpened);
+            subs.Event<FishBluespaceSetEnabledMessage>(OnSetEnabled);
+            subs.Event<FishBluespaceSetPowerModeMessage>(OnSetPowerMode);
+            subs.Event<FishBluespaceSetLootCategoryMessage>(OnSetLootCategory);
+        });
+    }
+
+    private void OnMapInit(Entity<FishBluespaceHarvesterComponent> ent, ref MapInitEvent args)
+    {
+        UpdateInterlock(ent);
+        UpdatePowerDraw(ent);
+        UpdateAppearance(ent);
+    }
+
+    private void OnShutdown(Entity<FishBluespaceHarvesterComponent> ent, ref ComponentShutdown args)
+    {
+        SetPowerDraw(ent, 0f);
+        _appearance.SetData(ent, FishBluespaceDeviceVisuals.Working, false);
+    }
+
+    private void OnPaused(Entity<FishBluespaceHarvesterComponent> ent, ref EntityPausedEvent args)
+    {
+        SetPowerDraw(ent, 0f);
+        _appearance.SetData(ent, FishBluespaceDeviceVisuals.Working, false);
+    }
+
+    private void OnAnchorChanged(Entity<FishBluespaceHarvesterComponent> ent, ref AnchorStateChangedEvent args)
+    {
+        if (!args.Anchored)
+            SetPowerDraw(ent, 0f);
+    }
+
+    private void OnInserted(Entity<FishBluespaceHarvesterComponent> ent, ref EntGotInsertedIntoContainerMessage args)
+    {
+        SetPowerDraw(ent, 0f);
+    }
+
+    /// <summary>Checks operating prerequisites and actual positive HV receipt without changing state.</summary>
+    public bool CanOperate(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        return CanRequestPower(ent) && _powerConsumerQuery.TryComp(ent, out var consumer) &&
+               float.IsFinite(consumer.DrawRate) && consumer.DrawRate > 0f &&
+               float.IsFinite(consumer.ReceivedPower) && consumer.ReceivedPower > 0f;
+    }
+
+    /// <inheritdoc/>
+    public override void Update(float frameTime)
+    {
+        base.Update(frameTime);
+        if (!float.IsFinite(frameTime) || frameTime <= 0f)
+            return;
+
+        var query = EntityQueryEnumerator<FishBluespaceHarvesterComponent>();
+        while (query.MoveNext(out var uid, out var harvester))
+        {
+            Entity<FishBluespaceHarvesterComponent> ent = (uid, harvester);
+            UpdateInterlock(ent);
+            UpdatePowerDraw(ent);
+
+            // Fish-edit: после изменения нагрузки ждём новый расчёт сети; задержки не превращаем в накопленные циклы.
+            if (!harvester.SkipPowerSample && CanOperate(ent))
+                AccumulateEnergy(ent, MathF.Min(frameTime, 1f));
+            harvester.SkipPowerSample = false;
+
+            if (_timing.CurTime >= harvester.NextOutputCheck)
+            {
+                harvester.NextOutputCheck = _timing.CurTime + CheckInterval;
+                if (CanOperate(ent))
+                {
+                    if (harvester.StoredEnergy >= harvester.EnergyPerReward)
+                        TryProduceReward(ent);
+
+                    TryOpenIncursion(ent);
+                    TrySpawnAnomaly(ent);
+                }
+            }
+
+            UpdateAppearance(ent);
+            if (_timing.CurTime < harvester.NextUiUpdate)
+                continue;
+
+            harvester.NextUiUpdate = _timing.CurTime + CheckInterval;
+            UpdateUi(ent);
+        }
+    }
+
+    private bool CanRequestPower(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        return !TerminatingOrDeleted(ent) && ent.Comp.Enabled && !IsCritical(ent) &&
+               float.IsFinite(ent.Comp.EnergyPerReward) && ent.Comp.EnergyPerReward > 0f &&
+               float.IsFinite(ent.Comp.BackgroundPerMegajoule) && ent.Comp.BackgroundPerMegajoule >= 0f &&
+               float.IsFinite(ent.Comp.OverdriveBackgroundMultiplier) && ent.Comp.OverdriveBackgroundMultiplier >= 1f &&
+               GetRequestedPower(ent) > 0f && IsOnWorldFloor(ent) &&
+               _powerStateQuery.HasComp(ent) &&
+               _bluespaceBackground.TryGetScope(ent, out var station) &&
+               _metaQuery.TryComp(station, out var stationMeta) && !stationMeta.EntityPaused &&
+               _powerConsumerQuery.TryComp(ent, out var consumer) && consumer.Net != null;
+    }
+
+    private bool IsOnWorldFloor(EntityUid uid)
+    {
+        if (!_metaQuery.TryComp(uid, out var meta) || meta.EntityPaused ||
+            !_transformQuery.TryComp(uid, out var xform) || !xform.Anchored ||
+            xform.MapID == MapId.Nullspace || xform.GridUid is not { } grid ||
+            xform.ParentUid != grid || _container.IsEntityOrParentInContainer(uid, meta, xform))
+            return false;
+
+        return _turf.GetTileRef(xform.Coordinates) is { } tile && tile.GridUid == grid && !_turf.IsSpace(tile);
+    }
+
+    private bool IsCritical(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        if (_bluespaceBackground.IsCritical(ent))
+            return true;
+
+        var threshold = ent.Comp.Critical ? ent.Comp.RestartLevel : ent.Comp.CriticalLevel;
+        return !float.IsFinite(threshold) || _bluespaceBackground.GetLevel(ent) >= Math.Clamp(threshold, 0f, 100f);
+    }
+
+    private void UpdateInterlock(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        ent.Comp.Critical = IsCritical(ent);
+        if (!ent.Comp.Critical)
+            return;
+
+        ent.Comp.Enabled = false;
+        SetPowerDraw(ent, 0f);
+    }
+
+    private float GetRequestedPower(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        var requested = ent.Comp.PowerMode switch
+        {
+            FishBluespacePowerMode.Normal => ent.Comp.NormalPowerDraw,
+            FishBluespacePowerMode.Overdrive => ent.Comp.OverdrivePowerDraw,
+            _ => 0f,
+        };
+        return float.IsFinite(requested) && requested > 0f ? requested : 0f;
+    }
+
+    private void UpdatePowerDraw(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        var requested = CanRequestPower(ent) ? GetRequestedPower(ent) : 0f;
+        SetPowerDraw(ent, requested);
+    }
+
+    private void SetPowerDraw(Entity<FishBluespaceHarvesterComponent> ent, float requested)
+    {
+        if (!_powerConsumerQuery.TryComp(ent, out var consumer))
+            return;
+
+        if (!_powerStateQuery.TryComp(ent, out var powerState))
+        {
+            consumer.DrawRate = 0f;
+            return;
+        }
+
+        if (consumer.DrawRate == requested && powerState.IsWorking == (requested > 0f))
+            return;
+
+        // Fish-edit: штатный setter управляет IsWorking, а переменная HV-нагрузка задаётся через PowerConsumer.
+        ent.Comp.SkipPowerSample = true;
+        _powerState.SetWorkingState((ent.Owner, powerState), requested > 0f);
+        consumer.DrawRate = requested;
+    }
+
+    private void AccumulateEnergy(Entity<FishBluespaceHarvesterComponent> ent, float frameTime)
+    {
+        var consumer = _powerConsumerQuery.Comp(ent);
+        var energy = (double) MathF.Min(consumer.ReceivedPower, consumer.DrawRate) * frameTime;
+        if (!double.IsFinite(energy) || energy <= 0d)
+            return;
+
+        var multiplier = ent.Comp.PowerMode == FishBluespacePowerMode.Overdrive
+            ? ent.Comp.OverdriveBackgroundMultiplier
+            : 1f;
+        var background = energy / 1_000_000d * ent.Comp.BackgroundPerMegajoule * multiplier;
+        if (!double.IsFinite(background) || background > float.MaxValue ||
+            !_bluespaceBackground.TryAdjustLevel(ent, (float) background))
+            return;
+
+        if (!double.IsFinite(ent.Comp.StoredEnergy) || ent.Comp.StoredEnergy < 0d)
+            ent.Comp.StoredEnergy = 0d;
+
+        ent.Comp.StoredEnergy = Math.Min(ent.Comp.EnergyPerReward, ent.Comp.StoredEnergy + energy);
+        UpdateInterlock(ent);
+    }
+
+    private void UpdateAppearance(Entity<FishBluespaceHarvesterComponent> ent)
+    {
+        _appearance.SetData(ent, FishBluespaceDeviceVisuals.Working, CanOperate(ent));
+        _appearance.SetData(ent, FishBluespaceDeviceVisuals.Unstable,
+            ent.Comp.Critical || _bluespaceBackground.HasIncursionRisk(ent));
+    }
+}
