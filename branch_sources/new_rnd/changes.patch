+                research.ModifyServerPoints(context.ResearchServer, sourcePrototype.Cost + rewardCost - points);
+            });
+            await pair.RunUntilSynced();
+            await client.WaitPost(() =>
+            {
+                context.Window.SelectTechnology(source);
