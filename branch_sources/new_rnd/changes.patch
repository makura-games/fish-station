+    public async Task CrystalMovesThroughOreBagLatheAndSiloWithoutGrowth()
+    {
+        await WithLathe("Protolathe", async context =>
+        {
+            var server = context.Pair.Server;
+            var materials = server.System<MaterialStorageSystem>();
