diff --git a/Content.Client/_Fish/Research/UI/FishResearchConsoleMenu.xaml.cs b/Content.Client/_Fish/Research/UI/FishResearchConsoleMenu.xaml.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d21441d27310c893dc5f5fcfb8421747c9e0d686
--- /dev/null
+++ b/Content.Client/_Fish/Research/UI/FishResearchConsoleMenu.xaml.cs
@@ -0,0 +1,377 @@
+using System.Linq;
+using System.Numerics;
+using Content.Client.Research;
+using Content.Client.Stylesheets;
+using Content.Client.Stylesheets.Palette;
+using Content.Client.UserInterface.Controls;
+using Content.Shared.Access.Components;
+using Content.Shared.Access.Systems;
+using Content.Shared.Lathe;
+using Content.Shared.Research.Components;
+using Content.Shared.Research.Prototypes;
+using Robust.Client.AutoGenerated;
+using Robust.Client.GameObjects;
+using Robust.Client.Graphics;
+using Robust.Client.Player;
+using Robust.Client.UserInterface;
+using Robust.Client.UserInterface.Controls;
+using Robust.Client.UserInterface.XAML;
+using Robust.Shared.Prototypes;
+
+namespace Content.Client._Fish.Research.UI;
+
+/// <summary>
+/// Presents the existing research console rules as a browsable technology tree.
+/// The server remains authoritative for research availability, prices and purchases.
+/// </summary>
+[GenerateTypedNameReferences]
+public sealed partial class FishResearchConsoleMenu : FancyWindow
+{
+    [Dependency] private IEntityManager _entity = default!;
+    [Dependency] private IPrototypeManager _prototype = default!;
+    [Dependency] private IPlayerManager _player = default!;
+    [Dependency] private ILocalizationManager _loc = default!;
+
+    private readonly ResearchSystem _research;
+    private readonly SpriteSystem _sprite;
+    private readonly AccessReaderSystem _accessReader;
+    private readonly SharedLatheSystem _lathe;
+    private readonly Dictionary<ProtoId<TechnologyPrototype>, FishResearchNodeState> _nodeStates = new();
+    private readonly HashSet<ProtoId<TechDisciplinePrototype>> _supported = new();
+    private readonly HashSet<ProtoId<TechnologyPrototype>> _unlocked = new();
+    private readonly Dictionary<ProtoId<TechDisciplinePrototype>, Button> _disciplineButtons = new();
+    private readonly Dictionary<ProtoId<TechDisciplinePrototype>, RichTextLabel> _disciplineProgress = new();
+    private FishResearchTreeCatalog? _catalog;
+    private ProtoId<TechDisciplinePrototype>? _filterDiscipline;
+    private Button? _allDisciplinesButton;
+    private EntityUid _console;
+    private int _points;
+    private bool _hasAccess;
+    private bool _forceRefresh = true;
+    private bool _detailsDirty = true;
+    private bool _centerAfterNavigation;
+
+    /// <summary>Requests an existing console purchase message for an available technology.</summary>
+    public event Action<string>? OnTechnologyCardPressed;
+
+    /// <summary>Requests the existing server selection interface.</summary>
+    public event Action? OnServerButtonPressed;
+
+    /// <summary>The selected technology, preserved across ordinary console updates.</summary>
+    public ProtoId<TechnologyPrototype>? SelectedTechnology => Graph.SelectedTechnology;
+
+    public FishResearchConsoleMenu()
+    {
+        RobustXamlLoader.Load(this);
+        IoCManager.InjectDependencies(this);
+        _research = _entity.System<ResearchSystem>();
+        _sprite = _entity.System<SpriteSystem>();
+        _accessReader = _entity.System<AccessReaderSystem>();
+        _lathe = _entity.System<SharedLatheSystem>();
+
+        HeaderPanel.PanelOverride = PanelStyle(Palettes.Navy.Background);
+        SidebarPanel.PanelOverride = PanelStyle(Palettes.Slate.Background);
+        GraphPanel.PanelOverride = PanelStyle(Palettes.Slate.BackgroundDark);
+        DetailsPanel.PanelOverride = PanelStyle(Palettes.Navy.BackgroundDark);
+        FooterPanel.PanelOverride = PanelStyle(Palettes.Slate.Background);
+        ResearchedLegend.FontColorOverride = FishResearchTreeControl.StateColor(FishResearchNodeState.Researched);
+        AvailableLegend.FontColorOverride = FishResearchTreeControl.StateColor(FishResearchNodeState.Available);
+        LockedLegend.FontColorOverride = FishResearchTreeControl.StateColor(FishResearchNodeState.Locked);
+        NavigationHint.ToolTip = _loc.GetString("fish-research-tree-navigation");
+        FreeChoiceHint.ToolTip = _loc.GetString("fish-research-tree-free-choice");
+        ZoomInButton.ToolTip = _loc.GetString("fish-research-tree-zoom-in");
+        ZoomOutButton.ToolTip = _loc.GetString("fish-research-tree-zoom-out");
+
+        var available = UserInterfaceManager.WindowRoot.Size - new Vector2(24);
+        if (available.X > 0 && available.Y > 0)
+        {
+            MinSize = Vector2.Min(new Vector2(800, 480), available);
+            SetSize = Vector2.Min(new Vector2(1100, 700), available);
+            if (available.X < 820)
+            {
+                SidebarPanel.Visible = false;
+                SidebarButton.Pressed = false;
+                DetailsPanel.SetWidth = 230;
+            }
+        }
+
+        ServerButton.OnPressed += _ => OnServerButtonPressed?.Invoke();
+        ResearchButton.OnPressed += _ => TryResearchSelected();
+        SearchEdit.OnTextChanged += _ => ApplyFilter();
+        SidebarButton.OnToggled += args => SidebarPanel.Visible = args.Pressed;
+        CenterButton.OnPressed += _ => Graph.CenterSelection();
+        ZoomInButton.OnPressed += _ => Graph.ZoomAt(1.12f, Graph.Size / 2);
+        ZoomOutButton.OnPressed += _ => Graph.ZoomAt(1 / 1.12f, Graph.Size / 2);
+        ResetButton.OnPressed += _ =>
+        {
+            Graph.SetViewport(0.8f, new Vector2(20, 20));
+            Graph.CenterSelection();
+        };
+        Graph.OnTechnologySelected += _ =>
+        {
+            _detailsDirty = true;
+            RefreshDetails();
+        };
+        Graph.OnViewChanged += UpdateViewLabels;
+        RefreshDetails();
+        UpdateViewLabels();
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 finalSize)
+    {
+        var size = base.ArrangeOverride(finalSize);
+        if (_centerAfterNavigation && TreeContent.Visible)
+        {
+            _centerAfterNavigation = false;
+            Graph.CenterSelection();
+        }
+
+        return size;
+    }
+
+    private static StyleBoxFlat PanelStyle(Color background) => new()
+    {
+        BackgroundColor = background,
+        BorderColor = Palettes.Slate.Element,
+        BorderThickness = new Thickness(1),
+    };
+
+    /// <summary>Binds the window to the console's existing networked technology database.</summary>
+    public void SetEntity(EntityUid entity)
+    {
+        _console = entity;
+        _forceRefresh = true;
+    }
+
+    /// <summary>Updates node states while retaining catalog, filter, selection, pan and zoom.</summary>
+    public void UpdatePanels(ResearchConsoleBoundInterfaceState state)
+    {
+        _points = state.Points;
+        if (!_entity.TryGetComponent(_console, out TechnologyDatabaseComponent? database))
+        {
+            ResearchButton.Disabled = true;
+            PurchaseStatusLabel.SetMessage(_loc.GetString("fish-research-tree-no-database"));
+            return;
+        }
+
+        var catalogChanged = _forceRefresh || _catalog == null || !_supported.SetEquals(database.SupportedDisciplines);
+        if (catalogChanged)
+        {
+            _supported.Clear();
+            _supported.UnionWith(database.SupportedDisciplines);
+            _catalog = new FishResearchTreeCatalog(_prototype, _loc, _sprite, _lathe, database.SupportedDisciplines);
+            Graph.SetCatalog(_catalog, _loc);
+            BuildDisciplineList();
+            _forceRefresh = false;
+        }
+
+        var progressChanged = catalogChanged || !_unlocked.SetEquals(database.UnlockedTechnologies);
+        _unlocked.Clear();
+        _unlocked.UnionWith(database.UnlockedTechnologies);
+        _hasAccess = HasConsoleAccess();
+
+        var catalog = _catalog!;
+        var disciplineTiers = _research.GetDisciplineTiers(database);
+        _nodeStates.Clear();
+        foreach (var (id, technology) in catalog.Technologies)
+        {
+            var nodeState = _unlocked.Contains(id)
+                ? FishResearchNodeState.Researched
+                : !_research.IsTechnologyAvailable(database, technology.Prototype, disciplineTiers)
+                    ? FishResearchNodeState.Locked
+                    : FishResearchNodeState.Available;
+            _nodeStates.Add(id, nodeState);
+        }
+        Graph.UpdateStates(_nodeStates);
+
+        if (progressChanged)
+            UpdateDisciplineProgress();
+
+        if (SelectedTechnology == null)
+        {
+            var initial = catalog.Technologies.Keys.FirstOrDefault(id => _nodeStates[id] == FishResearchNodeState.Available);
+            if (initial == default)
+                initial = catalog.Technologies.Keys.FirstOrDefault();
+            if (initial != default)
+            {
+                Graph.SelectTechnology(initial);
+                Graph.CenterSelection();
+            }
+        }
+
+        _detailsDirty |= catalogChanged || progressChanged;
+        RefreshDetails();
+    }
+
+    /// <summary>Refreshes the research point balance and purchase availability.</summary>
+    public void UpdateInformationPanel(ResearchConsoleBoundInterfaceState state)
+    {
+        _points = state.Points;
+        PointsLabel.Text = _loc.GetString("fish-research-tree-points", ("points", state.Points));
+        UpdatePurchaseStatus();
+    }
+
+    /// <summary>Rebuilds cached prototype presentation after relevant hot reloads.</summary>
+    public void OnProtoReload(PrototypesReloadedEventArgs args)
+    {
+        if (!args.WasModified<TechnologyPrototype>() && !args.WasModified<TechDisciplinePrototype>() &&
+            !args.WasModified<LatheRecipePrototype>() && !args.WasModified<EntityPrototype>())
+            return;
+
+        _forceRefresh = true;
+        UpdatePanels(new ResearchConsoleBoundInterfaceState(_points));
+        UpdateInformationPanel(new ResearchConsoleBoundInterfaceState(_points));
+    }
+
+    /// <summary>Selects a technology in the catalog without purchasing it.</summary>
+    public bool SelectTechnology(ProtoId<TechnologyPrototype> id) => Graph.SelectTechnology(id);
+
+    private bool HasConsoleAccess()
+    {
+        if (_player.LocalEntity is not { } local ||
+            !_entity.TryGetComponent<AccessReaderComponent>(_console, out var access) || !access.Enabled)
+            return true;
+
+        // Fish-edit: обновление прав в дереве не создаёт записи в журнале доступа.
+        var items = _accessReader.FindPotentialAccessItems(local);
+        var tags = _accessReader.FindAccessTags(local, items);
+        _accessReader.FindStationRecordKeys(local, out var keys, items);
+        return _accessReader.IsAllowed(tags, keys, _console, access);
+    }
+
+    private void TryResearchSelected()
+    {
+        if (SelectedTechnology is not { } id || _catalog == null || !_catalog.Technologies.TryGetValue(id, out var technology) ||
+            !_entity.TryGetComponent(_console, out TechnologyDatabaseComponent? database))
+            return;
+
+        if (_points < technology.Prototype.Cost ||
+            !HasConsoleAccess() || !_research.IsTechnologyAvailable(database, technology.Prototype))
+            return;
+
+        OnTechnologyCardPressed?.Invoke(technology.Prototype.ID);
+    }
+
+    private void BuildDisciplineList()
+    {
+        DisciplineList.RemoveAllChildren();
+        _disciplineButtons.Clear();
+        _disciplineProgress.Clear();
+        var allName = _loc.GetString("fish-research-tree-all");
+        _allDisciplinesButton = new Button { Text = allName, ToolTip = allName, ToggleMode = true };
+        StyleDisciplineButton(_allDisciplinesButton);
+        _allDisciplinesButton.OnPressed += _ => SetDiscipline(null);
+        DisciplineList.AddChild(_allDisciplinesButton);
+
+        if (_catalog == null)
+            return;
+        if (_filterDiscipline is { } filter && !_catalog.Disciplines.ContainsKey(filter))
+            _filterDiscipline = null;
+
+        foreach (var (id, discipline) in _catalog.Disciplines)
+        {
+            var group = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Vertical, SeparationOverride = 3 };
+            var name = _loc.GetString(discipline.Name);
+            var button = new Button { Text = name, ToolTip = name, ToggleMode = true, HorizontalExpand = true };
+            StyleDisciplineButton(button);
+            button.OnPressed += _ => SetDiscipline(id);
+            var heading = new BoxContainer { SeparationOverride = 6, HorizontalExpand = true };
+            heading.AddChild(new TextureRect
+            {
+                Texture = _catalog.DisciplineIcons[id],
+                SetSize = new(24, 24),
+                Stretch = TextureRect.StretchMode.KeepAspectCentered,
+                VerticalAlignment = VAlignment.Center,
+                ModulateSelfOverride = discipline.Color,
+            });
+            heading.AddChild(button);
+            group.AddChild(heading);
+            var progress = new RichTextLabel { HorizontalExpand = true };
+            group.AddChild(progress);
+            DisciplineList.AddChild(group);
+            _disciplineButtons.Add(id, button);
+            _disciplineProgress.Add(id, progress);
+        }
+        UpdateDisciplineButtons();
+        Graph.SetFilter(_filterDiscipline, SearchEdit.Text);
+    }
+
+    private void StyleDisciplineButton(Button button)
+    {
+        button.Label.Visible = false;
+        var caption = Text(button.Text ?? string.Empty);
+        caption.AddStyleClass(StyleClass.FontSmall);
+        caption.MouseFilter = MouseFilterMode.Ignore;
+        button.AddChild(caption);
+    }
+
+    private void SetDiscipline(ProtoId<TechDisciplinePrototype>? discipline)
+    {
+        _filterDiscipline = discipline;
+        UpdateDisciplineButtons();
+        ApplyFilter();
+    }
+
+    private void UpdateDisciplineButtons()
+    {
+        if (_allDisciplinesButton != null)
+            _allDisciplinesButton.Pressed = _filterDiscipline == null;
+        foreach (var (id, button) in _disciplineButtons)
+            button.Pressed = _filterDiscipline == id;
+    }
+
+    private void ApplyFilter()
+    {
+        Graph.SetFilter(_filterDiscipline, SearchEdit.Text);
+        if (SelectedTechnology is { } selected && Graph.VisibleTechnologyIds.Contains(selected))
+            Graph.CenterSelection();
+        else if (Graph.VisibleTechnologyIds.FirstOrDefault() is var first && first != default)
+        {
+            Graph.SelectTechnology(first);
+            Graph.CenterSelection();
+        }
+        UpdateViewLabels();
+    }
+
+    private void NavigateToTechnology(ProtoId<TechnologyPrototype> id)
+    {
+        if (_catalog == null || !_catalog.Technologies.ContainsKey(id))
+            return;
+
+        if (!Graph.VisibleTechnologyIds.Contains(id))
+        {
+            SearchEdit.Text = string.Empty;
+            SetDiscipline(null);
+        }
+        Graph.SelectTechnology(id);
+        // Fish-start: после смены фильтра центрируем дерево с актуальным размером раскладки.
+        _centerAfterNavigation = true;
+        InvalidateArrange();
+        // Fish-end
+    }
+
+    private void UpdateViewLabels()
+    {
+        ZoomLabel.Text = _loc.GetString("fish-research-tree-zoom", ("percent", MathF.Round(Graph.Zoom * 100)));
+        ResultCountLabel.Text = _loc.GetString("fish-research-tree-visible", ("count", Graph.VisibleTechnologyIds.Count), ("total", _catalog?.Technologies.Count ?? 0));
+        ResultCountLabel.ToolTip = ResultCountLabel.Text;
+    }
+
+    private void UpdateDisciplineProgress()
+    {
+        if (_catalog == null)
+            return;
+        foreach (var (id, label) in _disciplineProgress)
+        {
+            var technologies = _catalog.Technologies.Values.Where(technology => technology.Prototype.Discipline == id).ToArray();
+            var lines = new List<string>();
+            foreach (var tier in technologies.Select(technology => technology.Prototype.Tier).Distinct().Order())
+            {
+                var tierTechnologies = technologies.Where(technology => technology.Prototype.Tier == tier).ToArray();
+                var count = tierTechnologies.Count(technology => _unlocked.Contains(technology.Prototype.ID));
+                lines.Add(_loc.GetString("fish-research-tree-tier-progress", ("tier", tier), ("unlocked", count), ("total", tierTechnologies.Length)));
+            }
+            label.SetMessage(string.Join('\n', lines));
+        }
+    }
+}
diff --git a/Content.Client/_Fish/Research/UI/FishResearchTreeCatalog.cs b/Content.Client/_Fish/Research/UI/FishResearchTreeCatalog.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c110171cf6a6a87533a58e69c9da22d5ba046a70
--- /dev/null
+++ b/Content.Client/_Fish/Research/UI/FishResearchTreeCatalog.cs
@@ -0,0 +1,111 @@
+using System.Linq;
+using Content.Shared.Lathe;
+using Content.Shared.Research.Prototypes;
+using Robust.Client.GameObjects;
+using Robust.Client.Graphics;
+using Robust.Shared.Prototypes;
+
+namespace Content.Client._Fish.Research.UI;
+
+/// <summary>
+/// Cached, localized presentation data shared by the graph and the details pane.
+/// </summary>
+internal sealed class FishResearchTreeCatalog
+{
+    public readonly Dictionary<ProtoId<TechnologyPrototype>, FishResearchTechnology> Technologies = new();
+    public readonly Dictionary<ProtoId<TechDisciplinePrototype>, TechDisciplinePrototype> Disciplines = new();
+    public readonly Dictionary<ProtoId<TechDisciplinePrototype>, Texture> DisciplineIcons = new();
+
+    public FishResearchTreeCatalog(
+        IPrototypeManager prototype,
+        ILocalizationManager loc,
+        SpriteSystem sprite,
+        SharedLatheSystem lathe,
+        IEnumerable<ProtoId<TechDisciplinePrototype>> supported)
+    {
+        foreach (var id in supported)
+        {
+            if (!prototype.TryIndex(id, out var discipline))
+                continue;
+
+            Disciplines.Add(id, discipline);
+            DisciplineIcons.Add(id, sprite.Frame0(discipline.Icon));
+        }
+
+        var recipes = new Dictionary<ProtoId<LatheRecipePrototype>, FishResearchRecipe>();
+        foreach (var technology in prototype.EnumeratePrototypes<TechnologyPrototype>())
+        {
+            if (technology.Hidden || !Disciplines.ContainsKey(technology.Discipline))
+                continue;
+
+            var unlocks = new List<FishResearchRecipe>();
+            foreach (var recipeId in technology.RecipeUnlocks)
+            {
+                if (!prototype.TryIndex(recipeId, out var recipe))
+                    continue;
+
+                if (!recipes.TryGetValue(recipeId, out var presentation))
+                {
+                    var name = lathe.GetRecipeName(recipe);
+                    if (string.IsNullOrWhiteSpace(name))
+                        name = loc.GetString("fish-research-tree-unnamed-recipe");
+
+                    // Fish-edit: пустой ResultReagents не поддерживает First() в описании станка.
+                    var description = recipe.Description != null || recipe.Result != null || recipe.ResultReagents?.Count > 0
+                        ? lathe.GetRecipeDescription(recipe)
+                        : string.Empty;
+                    Texture? icon = null;
+                    if (recipe.Icon != null)
+                        icon = sprite.Frame0(recipe.Icon);
+                    else if (recipe.Result is { } result && prototype.TryIndex(result, out var entity))
+                        icon = sprite.Frame0(entity);
+
+                    presentation = new FishResearchRecipe(name, description, icon);
+                    recipes.Add(recipeId, presentation);
+                }
+
+                unlocks.Add(presentation);
+            }
+
+            var title = loc.GetString(technology.Name);
+            var key = GetDescriptionKey(technology);
+            var purpose = loc.TryGetString(key, out var descriptionText)
+                ? descriptionText
+                : loc.GetString("fish-research-tree-description-fallback");
+            Technologies.Add(technology.ID, new FishResearchTechnology(
+                technology,
+                title,
+                purpose,
+                loc.GetString("fish-research-tree-node-meta", ("tier", technology.Tier), ("cost", technology.Cost)),
+                sprite.Frame0(technology.Icon),
+                unlocks,
+                string.Join('\n', unlocks.Select(recipe => recipe.Name).Prepend(title))));
+        }
+    }
+
+    /// <summary>
+    /// Normalizes legacy technology names for the fork's description keys.
+    /// </summary>
+    public static string GetDescriptionKey(TechnologyPrototype technology)
+    {
+        return $"fish-{technology.Name.ToString().Replace('_', '-').ToLowerInvariant()}-description";
+    }
+}
+
+internal sealed record FishResearchRecipe(string Name, string Description, Texture? Icon);
+
+internal sealed record FishResearchTechnology(
+    TechnologyPrototype Prototype,
+    string Name,
+    string Description,
+    string Metadata,
+    Texture Icon,
+    IReadOnlyList<FishResearchRecipe> Recipes,
+    string SearchText);
+
+internal enum FishResearchNodeState : byte
+{
+    Locked,
+    Available,
+    Researched,
+}
diff --git a/Content.Client/_Fish/Research/UI/FishResearchTreeControl.Layout.cs b/Content.Client/_Fish/Research/UI/FishResearchTreeControl.Layout.cs
new file mode 100644
index 0000000000000000000000000000000000000000..05dee842091579278ecb2885e2333e87404f1065
--- /dev/null
+++ b/Content.Client/_Fish/Research/UI/FishResearchTreeControl.Layout.cs
@@ -0,0 +1,153 @@
+using System.Linq;
+using System.Numerics;
+using Content.Shared.Research.Prototypes;
+using Robust.Shared.Prototypes;
+
+namespace Content.Client._Fish.Research.UI;
+
+public sealed partial class FishResearchTreeControl
+{
+    private const float RoutingClearance = 10;
+
+    // Fish-edit: фильтр пересобирает только видимый подграф; обновления очков сюда не заходят.
+    private void RebuildLayout()
+    {
+        _nodes.Clear();
+        _nodeBounds.Clear();
+        _edges.Clear();
+        _lanes.Clear();
+        if (_catalog == null)
+            return;
+
+        var layers = new Dictionary<ProtoId<TechnologyPrototype>, int>();
+        foreach (var technology in _visible)
+            GetLayer(technology, layers, new HashSet<ProtoId<TechnologyPrototype>>());
+
+        // Fish-edit: пустые ранги удаляются без изменения порядка зависимых технологий.
+        var compactLayers = layers.Values.Distinct().Order().Select((layer, column) => (layer, column))
+            .ToDictionary(pair => pair.layer, pair => pair.column);
+        var laneY = 24f;
+        foreach (var (disciplineId, discipline) in _catalog.Disciplines)
+        {
+            var technologies = _catalog.Technologies
+                .Where(pair => _visible.Contains(pair.Key) && pair.Value.Prototype.Discipline == disciplineId)
+                .OrderBy(pair => pair.Value.Prototype.Tier)
+                .ThenBy(pair => pair.Value.Name, StringComparer.CurrentCulture)
+                .ToArray();
+            if (technologies.Length == 0)
+                continue;
+
+            _lanes.Add((new Vector2(24, laneY), _disciplineNames[disciplineId], discipline.Color));
+            var rows = new Dictionary<int, int>();
+            foreach (var (id, technology) in technologies)
+            {
+                var column = compactLayers[layers[id]];
+                rows.TryGetValue(column, out var row);
+                rows[column] = row + 1;
+                var position = new Vector2(24 + column * ColumnSpacing, laneY + 34 + row * RowSpacing);
+                _nodes.Add(id, new Node(technology, position, discipline.Color));
+                _nodeBounds.Add(id, UIBox2.FromDimensions(position, NodeSize));
+            }
+
+            laneY += 54 + rows.Values.Max() * RowSpacing;
+        }
+
+        foreach (var (id, node) in _nodes)
+        foreach (var prerequisite in node.Technology.Prototype.TechnologyPrerequisites)
+        {
+            if (!_nodeBounds.TryGetValue(prerequisite, out var from))
+                continue;
+            _edges.Add(new FishResearchTreeEdge(prerequisite, id, RouteEdge(from, _nodeBounds[id])));
+        }
+
+        _captionsDirty = true;
+        _hoveredTechnology = null;
+        ToolTip = null;
+        OnViewChanged?.Invoke();
+    }
+
+    private int GetLayer(ProtoId<TechnologyPrototype> id, Dictionary<ProtoId<TechnologyPrototype>, int> layers, HashSet<ProtoId<TechnologyPrototype>> visiting)
+    {
+        if (layers.TryGetValue(id, out var cached))
+            return cached;
+        if (!_visible.Contains(id) || _catalog == null || !_catalog.Technologies.TryGetValue(id, out var technology))
+            return -1;
+        if (!visiting.Add(id))
+            return technology.Prototype.Tier - 1;
+
+        // Fish-edit: один tier может содержать несколько последовательных зависимостей.
+        var layer = Math.Max(0, technology.Prototype.Tier - 1);
+        foreach (var prerequisite in technology.Prototype.TechnologyPrerequisites)
+            layer = Math.Max(layer, GetLayer(prerequisite, layers, visiting) + 1);
+
+        visiting.Remove(id);
+        layers[id] = layer;
+        return layer;
+    }
+
+    private IReadOnlyList<Vector2> RouteEdge(UIBox2 source, UIBox2 destination)
+    {
+        var from = new Vector2(source.Right, source.Center.Y);
+        var to = new Vector2(destination.Left, destination.Center.Y);
+        var gutter = (ColumnSpacing - NodeSize.X) / 2;
+        var sourceX = from.X + gutter;
+        var destinationX = to.X - gutter;
+
+        // Fish-edit: вертикали проходят только в межколоночных промежутках, где нет карточек.
+        if (MathF.Abs(sourceX - destinationX) < 0.01f)
+            return new[] { from, new Vector2(sourceX, from.Y), new Vector2(destinationX, to.Y), to };
+
+        var left = MathF.Min(sourceX, destinationX);
+        var right = MathF.Max(sourceX, destinationX);
+        var blockers = new List<UIBox2>();
+        var corridors = new HashSet<float> { from.Y, to.Y };
+        foreach (var bounds in _nodeBounds.Values)
+        {
+            if (bounds.Right + RoutingClearance <= left || bounds.Left - RoutingClearance >= right)
+                continue;
+            blockers.Add(bounds);
+            corridors.Add(bounds.Top - RoutingClearance);
+            corridors.Add(bounds.Bottom + RoutingClearance);
+        }
+
+        var bestY = from.Y;
+        var bestLength = float.PositiveInfinity;
+        var middleY = (from.Y + to.Y) / 2;
+        foreach (var corridor in corridors)
+        {
+            var blocked = false;
+            foreach (var bounds in blockers)
+            {
+                if (corridor <= bounds.Top - RoutingClearance || corridor >= bounds.Bottom + RoutingClearance)
+                    continue;
+                blocked = true;
+                break;
+            }
+            if (blocked)
+                continue;
+
+            var length = MathF.Abs(corridor - from.Y) + MathF.Abs(corridor - to.Y);
+            if (length > bestLength || length == bestLength && MathF.Abs(corridor - middleY) >= MathF.Abs(bestY - middleY))
+                continue;
+            bestLength = length;
+            bestY = corridor;
+        }
+
+        // Fish-edit: верхняя и нижняя границы blockers гарантируют существование свободного коридора.
+        return new[]
+        {
+            from,
+            new Vector2(sourceX, from.Y),
+            new Vector2(sourceX, bestY),
+            new Vector2(destinationX, bestY),
+            new Vector2(destinationX, to.Y),
+            to,
+        };
+    }
+}
+
+/// <summary>A directed prerequisite path in graph coordinates, cached until the visible layout changes.</summary>
+internal sealed record FishResearchTreeEdge(
+    ProtoId<TechnologyPrototype> From,
+    ProtoId<TechnologyPrototype> To,
+    IReadOnlyList<Vector2> Points);
diff --git a/Content.Client/_Fish/Research/UI/FishResearchTreeControl.cs b/Content.Client/_Fish/Research/UI/FishResearchTreeControl.cs
new file mode 100644
index 0000000000000000000000000000000000000000..fdcc25fde8f6a6f375cbb95ea823d08ba0719eb7
--- /dev/null
+++ b/Content.Client/_Fish/Research/UI/FishResearchTreeControl.cs
@@ -0,0 +1,423 @@
+using System.Numerics;
+using Content.Client.Stylesheets.Palette;
+using Content.Shared.Research.Prototypes;
+using Robust.Client.Graphics;
+using Robust.Client.UserInterface;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Input;
+using Robust.Shared.Prototypes;
+
+namespace Content.Client._Fish.Research.UI;
+
+/// <summary>
+/// A clipped technology graph. Layout and input use UI units; rendering uses local physical pixels.
+/// </summary>
+public sealed partial class FishResearchTreeControl : Control
+{
+    private static readonly Vector2 NodeSize = new(252, 168);
+    private static readonly Color ResearchedTextColor = Color.InterpolateBetween(Palettes.Green.Base, Color.White, 0.35f);
+    private static readonly Color AvailableTextColor = Color.InterpolateBetween(Palettes.Navy.Base, Color.White, 0.55f);
+    private static readonly Color LockedTextColor = Color.InterpolateBetween(Palettes.Slate.Base, Color.White, 0.45f);
+    private const float ColumnSpacing = 308;
+    private const float RowSpacing = 190;
+    private const float CaptionTop = 14;
+    private const float MetadataTop = 116;
+    private const float StatusTop = 142;
+    private readonly Dictionary<ProtoId<TechnologyPrototype>, Node> _nodes = new();
+    private readonly Dictionary<ProtoId<TechnologyPrototype>, UIBox2> _nodeBounds = new();
+    private readonly List<FishResearchTreeEdge> _edges = new();
+    private readonly Dictionary<ProtoId<TechDisciplinePrototype>, string> _disciplineNames = new();
+    private readonly List<(Vector2 Position, string Name, Color Color)> _lanes = new();
+    private readonly Dictionary<ProtoId<TechnologyPrototype>, FishResearchNodeState> _states = new();
+    private readonly Dictionary<FishResearchNodeState, string> _stateNames = new();
+    private readonly StyleBoxFlat _nodeBox = new();
+    private readonly HashSet<ProtoId<TechnologyPrototype>> _visible = new();
+    private FishResearchTreeCatalog? _catalog;
+    private ProtoId<TechDisciplinePrototype>? _discipline;
+    private string _search = string.Empty;
+    private bool _dragging;
+    private float _dragDistance;
+    private Vector2 _pressPosition;
+    private ProtoId<TechnologyPrototype>? _pressedTechnology;
+    private ProtoId<TechnologyPrototype>? _hoveredTechnology;
+    private bool _captionsDirty = true;
+    private bool _centerWhenSized;
+
+    /// <summary>Raised when a node is selected, without purchasing it.</summary>
+    public event Action<ProtoId<TechnologyPrototype>>? OnTechnologySelected;
+
+    /// <summary>Raised after the graph viewport or its visible subset changes.</summary>
+    public event Action? OnViewChanged;
+
+    /// <summary>Technologies currently shown, including prerequisites retained by a filter.</summary>
+    public IReadOnlyCollection<ProtoId<TechnologyPrototype>> VisibleTechnologyIds => _visible;
+
+    /// <summary>Scale relative to the graph's UI coordinates.</summary>
+    public float Zoom { get; private set; } = 0.8f;
+
+    /// <summary>Translation in UI units.</summary>
+    public Vector2 Pan { get; private set; } = new(20, 20);
+
+    /// <summary>The selected technology, which may lie outside the current filter.</summary>
+    public ProtoId<TechnologyPrototype>? SelectedTechnology { get; private set; }
+
+    /// <summary>Cached visible card bounds in graph coordinates, shared by rendering, routing and hit testing.</summary>
+    internal IReadOnlyDictionary<ProtoId<TechnologyPrototype>, UIBox2> NodeBounds => _nodeBounds;
+
+    /// <summary>Cached paths consumed directly by the renderer.</summary>
+    internal IReadOnlyList<FishResearchTreeEdge> Edges => _edges;
+
+    public FishResearchTreeControl()
+    {
+        MouseFilter = MouseFilterMode.Stop;
+        RectClipContent = true;
+    }
+
+    internal void SetCatalog(FishResearchTreeCatalog catalog, ILocalizationManager loc)
+    {
+        _catalog = catalog;
+        foreach (var state in Enum.GetValues<FishResearchNodeState>())
+            _stateNames[state] = loc.GetString($"fish-research-tree-state-{state.ToString().ToLowerInvariant()}");
+        _disciplineNames.Clear();
+        foreach (var (id, discipline) in catalog.Disciplines)
+            _disciplineNames.Add(id, loc.GetString(discipline.Name));
+
+        if (SelectedTechnology is { } selected && !catalog.Technologies.ContainsKey(selected))
+            SelectedTechnology = null;
+
+        RebuildVisibility();
+        RebuildLayout();
+    }
+
+    internal void UpdateStates(IReadOnlyDictionary<ProtoId<TechnologyPrototype>, FishResearchNodeState> states)
+    {
+        _states.Clear();
+        foreach (var (id, state) in states)
+            _states.Add(id, state);
+    }
+
+    /// <summary>Restores or changes a viewport without rebuilding the catalog or layout.</summary>
+    public void SetViewport(float zoom, Vector2 pan)
+    {
+        if (!float.IsFinite(zoom) || !float.IsFinite(pan.X) || !float.IsFinite(pan.Y))
+            return;
+
+        Zoom = Math.Clamp(zoom, 0.35f, 1.6f);
+        Pan = pan;
+        _centerWhenSized = false;
+        _captionsDirty = true;
+        OnViewChanged?.Invoke();
+    }
+
+    /// <summary>Shows matching technologies together with their transitive prerequisites.</summary>
+    public void SetFilter(ProtoId<TechDisciplinePrototype>? discipline, string search)
+    {
+        var trimmed = search.Trim();
+        if (_discipline == discipline && _search == trimmed)
+            return;
+        _discipline = discipline;
+        _search = trimmed;
+        RebuildVisibility();
+        RebuildLayout();
+    }
+
+    /// <summary>Selects a catalog entry. Selection never sends a purchase request.</summary>
+    public bool SelectTechnology(ProtoId<TechnologyPrototype> id)
+    {
+        if (_catalog == null || !_catalog.Technologies.ContainsKey(id))
+            return false;
+
+        SelectedTechnology = id;
+        OnTechnologySelected?.Invoke(id);
+        return true;
+    }
+
+    /// <summary>Moves the selected visible node to the center of the viewport.</summary>
+    public void CenterSelection()
+    {
+        if (SelectedTechnology is not { } selected || !_nodes.TryGetValue(selected, out var node) || !_visible.Contains(selected))
+            return;
+
+        if (Size.X <= 0 || Size.Y <= 0)
+        {
+            _centerWhenSized = true;
+            return;
+        }
+
+        SetViewport(Zoom, Size / 2 - (node.Position + NodeSize / 2) * Zoom);
+    }
+
+    /// <summary>Changes scale while keeping an anchor fixed in UI coordinates.</summary>
+    public void ZoomAt(float factor, Vector2 anchor)
+    {
+        var graphAnchor = UiToGraph(anchor);
+        var zoom = Math.Clamp(Zoom * factor, 0.35f, 1.6f);
+        SetViewport(zoom, anchor - graphAnchor * zoom);
+    }
+
+    private Vector2 GraphToUi(Vector2 position) => position * Zoom + Pan;
+    private Vector2 UiToGraph(Vector2 position) => (position - Pan) / Zoom;
+
+    private void RebuildVisibility()
+    {
+        _visible.Clear();
+        if (_catalog == null)
+            return;
+
+        var pending = new Stack<ProtoId<TechnologyPrototype>>();
+        foreach (var (id, technology) in _catalog.Technologies)
+        {
+            if (_discipline != null && technology.Prototype.Discipline != _discipline)
+                continue;
+            if (_search.Length != 0 && !technology.SearchText.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
+                continue;
+            pending.Push(id);
+        }
+
+        // Fish-edit: внешний prerequisite остаётся видимым вместе с междисциплинарным ребром.
+        while (pending.TryPop(out var id))
+        {
+            if (!_visible.Add(id) || !_catalog.Technologies.TryGetValue(id, out var technology))
+                continue;
+            foreach (var prerequisite in technology.Prototype.TechnologyPrerequisites)
+            {
+                if (_catalog.Technologies.ContainsKey(prerequisite))
+                    pending.Push(prerequisite);
+            }
+        }
+    }
+
+    protected override void KeyBindDown(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindDown(args);
+        if (args.Function != EngineKeyFunctions.UIClick && args.Function != EngineKeyFunctions.UIRightClick)
+            return;
+
+        _dragging = true;
+        _dragDistance = 0;
+        _pressPosition = args.RelativePosition;
+        _pressedTechnology = args.Function == EngineKeyFunctions.UIClick ? HitTest(args.RelativePosition) : null;
+        args.Handle();
+    }
+
+    protected override void KeyBindUp(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindUp(args);
+        if (args.Function != EngineKeyFunctions.UIClick && args.Function != EngineKeyFunctions.UIRightClick)
+            return;
+
+        if (_dragging && _dragDistance < 5 && Vector2.Distance(_pressPosition, args.RelativePosition) < 5 &&
+            SizeBox.Contains(args.RelativePosition) && _pressedTechnology is { } selected && HitTest(args.RelativePosition) == selected)
+            SelectTechnology(selected);
+
+        _dragging = false;
+        _pressedTechnology = null;
+        args.Handle();
+    }
+
+    protected override void MouseMove(GUIMouseMoveEventArgs args)
+    {
+        base.MouseMove(args);
+        if (_dragging)
+        {
+            _dragDistance += args.Relative.Length();
+            Pan += args.Relative;
+            OnViewChanged?.Invoke();
+        }
+
+        _hoveredTechnology = HitTest(args.RelativePosition);
+        ToolTip = _hoveredTechnology is { } id && _nodes.TryGetValue(id, out var node) ? node.Technology.Name : null;
+    }
+
+    protected override void MouseExited()
+    {
+        base.MouseExited();
+        _hoveredTechnology = null;
+        ToolTip = null;
+    }
+
+    protected override void ControlFocusExited()
+    {
+        base.ControlFocusExited();
+        _dragging = false;
+        _pressedTechnology = null;
+    }
+
+    protected override void MouseWheel(GUIMouseWheelEventArgs args)
+    {
+        base.MouseWheel(args);
+        ZoomAt(MathF.Pow(1.12f, args.Delta.Y), args.RelativePosition);
+        args.Handle();
+    }
+
+    private ProtoId<TechnologyPrototype>? HitTest(Vector2 position)
+    {
+        if (!SizeBox.Contains(position))
+            return null;
+        var graphPosition = UiToGraph(position);
+        foreach (var id in _visible)
+        {
+            if (_nodeBounds.TryGetValue(id, out var bounds) && bounds.Contains(graphPosition))
+                return id;
+        }
+        return null;
+    }
+
+    protected override void StylePropertiesChanged()
+    {
+        base.StylePropertiesChanged();
+        _captionsDirty = true;
+    }
+
+    protected override void UIScaleChanged()
+    {
+        base.UIScaleChanged();
+        _captionsDirty = true;
+    }
+
+    protected override void Resized()
+    {
+        base.Resized();
+        if (_centerWhenSized)
+            CenterSelection();
+    }
+
+    protected override void Draw(DrawingHandleScreen handle)
+    {
+        base.Draw(handle);
+        handle.DrawRect(PixelSizeBox, Palettes.Slate.BackgroundDark);
+        var font = StylePropertyDefault(Label.StylePropertyFont, UserInterfaceManager.ThemeDefaults.LabelFont);
+        if (_captionsDirty)
+        {
+            var textScale = UIScale * Zoom;
+            var captionHeight = (MetadataTop - CaptionTop - 8) * textScale;
+            foreach (var node in _nodes.Values)
+            {
+                node.Caption = WrapCaption(handle, font, node.Technology.Name, 184);
+                var height = handle.GetDimensions(font, node.Caption.AsSpan(), textScale).Y;
+                node.CaptionScale = height > 0 ? MathF.Min(1f, captionHeight / height) : 1f;
+            }
+            _captionsDirty = false;
+        }
+
+        DrawGrid(handle);
+        foreach (var (position, name, color) in _lanes)
+            DrawText(handle, font, position, name, color);
+
+        // Fish-start: выделенные связи и стрелки рисуются поверх общих серых участков.
+        DrawConnections(handle, highlighted: false);
+        DrawConnections(handle, highlighted: true);
+        // Fish-end
+
+        foreach (var id in _visible)
+        {
+            var node = _nodes[id];
+            var bounds = _nodeBounds[id];
+            var rect = ToPixels(bounds.TopLeft, bounds.Size);
+            if (!rect.Intersects(PixelSizeBox))
+                continue;
+
+            var state = _states.GetValueOrDefault(id);
+            var statusColor = StateColor(state);
+            var selected = SelectedTechnology == id;
+            var border = selected ? Palettes.Gold.Base : _hoveredTechnology == id ? node.Color : statusColor;
+            _nodeBox.BackgroundColor = selected ? Palettes.Navy.BackgroundLight : Palettes.Navy.BackgroundDark;
+            _nodeBox.BorderColor = border;
+            _nodeBox.BorderThickness = new Thickness(selected ? 2 : 1);
+            _nodeBox.Draw(handle, rect, UIScale * Zoom);
+            handle.DrawRect(ToPixels(node.Position, new Vector2(NodeSize.X, 4)), node.Color);
+            handle.DrawTextureRect(node.Technology.Icon, ToPixels(node.Position + new Vector2(12, 16), new Vector2(32)), Color.White);
+            DrawText(handle, font, node.Position + new Vector2(54, CaptionTop), node.Caption, Color.White, node.CaptionScale);
+            DrawText(handle, font, node.Position + new Vector2(12, MetadataTop), node.Technology.Metadata, Palettes.Gold.Base);
+            if (_stateNames.TryGetValue(state, out var stateName))
+                DrawText(handle, font, node.Position + new Vector2(12, StatusTop), stateName, statusColor);
+        }
+    }
+
+    private void DrawGrid(DrawingHandleScreen handle)
+    {
+        var step = 32 * Zoom * UIScale;
+        var offset = Pan * UIScale;
+        for (var x = offset.X % step; x < PixelWidth; x += step)
+        for (var y = offset.Y % step; y < PixelHeight; y += step)
+            handle.DrawRect(UIBox2.FromDimensions(new Vector2(x, y), new Vector2(1)), Palettes.Slate.BackgroundLight);
+    }
+
+    private void DrawConnections(DrawingHandleScreen handle, bool highlighted)
+    {
+        foreach (var edge in _edges)
+        {
+            var active = SelectedTechnology == edge.From || SelectedTechnology == edge.To;
+            if (active != highlighted)
+                continue;
+
+            var color = active ? _nodes[edge.From].Color : Palettes.Slate.HoveredElement;
+            DrawConnection(handle, edge.Points, color);
+        }
+    }
+
+    private void DrawConnection(DrawingHandleScreen handle, IReadOnlyList<Vector2> points, Color color)
+    {
+        for (var i = 1; i < points.Count; i++)
+            Line(points[i - 1], points[i]);
+        var to = points[^1];
+        Line(to + new Vector2(-7, -4), to);
+        Line(to + new Vector2(-7, 4), to);
+        return;
+
+        void Line(Vector2 a, Vector2 b) => handle.DrawLine(GraphToUi(a) * UIScale, GraphToUi(b) * UIScale, color);
+    }
+
+    private UIBox2 ToPixels(Vector2 position, Vector2 size) => UIBox2.FromDimensions(GraphToUi(position) * UIScale, size * Zoom * UIScale);
+
+    private void DrawText(DrawingHandleScreen handle, Font font, Vector2 position, string text, Color color, float fontScale = 1f)
+    {
+        handle.DrawString(font, GraphToUi(position) * UIScale, text.AsSpan(), UIScale * Zoom * fontScale, color);
+    }
+
+    private string WrapCaption(DrawingHandleScreen handle, Font font, string text, float width)
+    {
+        var scale = UIScale * Zoom;
+        var limit = width * scale;
+        var lines = new List<string>();
+        var remaining = text;
+        while (remaining.Length > 0)
+        {
+            if (handle.GetDimensions(font, remaining.AsSpan(), scale).X <= limit)
+            {
+                lines.Add(remaining);
+                break;
+            }
+
+            var split = remaining.Length;
+            while (split > 0 && handle.GetDimensions(font, remaining.AsSpan(0, split), scale).X > limit)
+                split--;
+            if (split > 0 && split < remaining.Length && char.IsSurrogatePair(remaining, split - 1))
+                split--;
+            if (split == 0)
+                split = char.IsSurrogatePair(remaining, 0) ? 2 : 1;
+            var space = remaining.LastIndexOf(' ', split - 1, split);
+            if (space > 0)
+                split = space;
+            lines.Add(remaining[..split].TrimEnd());
+            remaining = remaining[split..].TrimStart();
+        }
+        return string.Join('\n', lines);
+    }
+
+    internal static Color StateColor(FishResearchNodeState state) => state switch
+    {
+        FishResearchNodeState.Researched => ResearchedTextColor,
+        FishResearchNodeState.Available => AvailableTextColor,
+        _ => LockedTextColor,
+    };
+
+    private sealed class Node(FishResearchTechnology technology, Vector2 position, Color color)
+    {
+        public readonly FishResearchTechnology Technology = technology;
+        public readonly Vector2 Position = position;
+        public readonly Color Color = color;
+        public string Caption = string.Empty;
+        public float CaptionScale = 1f;
+    }
+}
