+
+            var prototype = pair.Server.ProtoMan.Index(prerequisite);
+            GrantPrerequisites(pair, researchServer, prototype, granted);
+            pair.Server.System<ServerResearchSystem>().AddTechnology(researchServer, prototype);
+        }
+    }
