+            await server.WaitAssertion(() =>
+            {
+                Assert.That(removed, Is.True);
+                Assert.That(inserted, Is.True);
+                Assert.That(materials.GetMaterialAmount(context.Lathe, CrystalMaterial), Is.Zero);
