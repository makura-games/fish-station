<comms:CommunicationsConsoleMenu xmlns="https://spacestation14.io"
    xmlns:comms="clr-namespace:Content.Client.Communications.UI"
    xmlns:widgets="clr-namespace:Content.Client.Communications.UI.Widgets"
    xmlns:sunriseWidgets="clr-namespace:Content.Client._Sunrise.Communications.UI.Widgets"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinSize="450 710" SetSize="450 710"
    Title="{Loc 'comms-console-menu-title'}">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="12">
        <PanelContainer StyleClasses="PanelDark" VerticalExpand="True">
            <widgets:MessagingControls Name="MessagingControls" VerticalExpand="True" />
        </PanelContainer>

        <controls:HSpacer Spacing="12" />

        <PanelContainer StyleClasses="BackgroundPanelDark">
            <!-- Sunrise edit start - выбор станции и дополнительные коды тревоги -->
            <BoxContainer Orientation="Vertical" Margin="0 12 0 12">
                <BoxContainer Name="AlertStationSelectorContainer"
                              Orientation="Horizontal"
                              Margin="9 0 9 4"
                              Visible="False">
                    <Label Text="{Loc 'comms-console-menu-alert-station'}"
                           VAlign="Center"
                           Margin="0 0 6 0"/>
                    <OptionButton Name="AlertStationButton"
                                  HorizontalExpand="True"/>
                </BoxContainer>
                <widgets:AlertLevelControls Name="AlertLevelControls" />
                <BoxContainer Name="AdditionalAlertLevelsSection" Orientation="Vertical" Margin="9 4 9 0">
                    <controls:StripeBack>
                        <Label HorizontalExpand="True"
                               Text="{Loc 'comms-console-menu-additional-alert-level-header'}"
                               VAlign="Center"
                               StyleClasses="LabelHeading"
                               Align="Center"/>
                    </controls:StripeBack>
                    <GridContainer Name="AdditionalAlertLevelsContainer" Columns="2"/>
                </BoxContainer>
            </BoxContainer>
            <!-- Sunrise edit end -->
        </PanelContainer>

        <controls:HSpacer Spacing="12" />

        <!-- Sunrise-Start: сохраняем управление ретрансляцией. -->
        <PanelContainer StyleClasses="BackgroundPanelDark">
            <sunriseWidgets:RelayControls Name="RelayControls" Margin="0 12 0 12" />
        </PanelContainer>

        <controls:HSpacer Spacing="12" />
        <!-- Sunrise-End -->

        <PanelContainer StyleClasses="BackgroundPanelDark">
            <widgets:ShuttleControls Name="ShuttleControls" Margin="0 12 0 12"/>
        </PanelContainer>
    </BoxContainer>
</comms:CommunicationsConsoleMenu>
