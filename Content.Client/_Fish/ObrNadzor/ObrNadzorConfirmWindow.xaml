<controls:ObrNadzorConfirmWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Fish.ObrNadzor"
    Title="{Loc 'obr-nadzor-confirm-title'}"
    MinSize="360 160">
    <BoxContainer Orientation="Vertical" Margin="12">
        <RichTextLabel Name="ConfirmText" Access="Public" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 16 0 0">
            <Button Name="CancelButton" Access="Public" Text="{Loc 'obr-nadzor-confirm-cancel'}"
                    HorizontalExpand="True" StyleClasses="OpenRight" />
            <Button Name="ConfirmButton" Access="Public" Text="{Loc 'obr-nadzor-confirm-ok'}"
                    HorizontalExpand="True" StyleClasses="Caution OpenLeft" />
        </BoxContainer>
    </BoxContainer>
</controls:ObrNadzorConfirmWindow>
