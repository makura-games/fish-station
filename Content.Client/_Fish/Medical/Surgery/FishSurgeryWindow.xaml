<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:fish="clr-namespace:Content.Client._Fish.Medical.Surgery"
    Title="{Loc 'surgery-window-name'}" SetSize="860 650" MinSize="760 560"
    HeaderClass="FishSurgeryHeader" TitleClass="FishSurgeryHeading">
    <PanelContainer StyleClasses="FishSurgeryBackground">
        <BoxContainer Orientation="Horizontal" SeparationOverride="18" Margin="16">
            <PanelContainer StyleClasses="FishSurgeryCard" SetWidth="230">
                <BoxContainer Orientation="Vertical" SeparationOverride="8">
                    <Label Text="{Loc 'fish-surgery-patient'}" StyleClasses="FishSurgeryCaption" />
                    <Label Name="PatientName" StyleClasses="FishSurgeryPatientName" ClipText="True" />
                    <PanelContainer StyleClasses="FishSurgeryDiagramFrame" VerticalExpand="True">
                        <fish:FishSurgeryBodyDiagram Name="BodyDiagram" Margin="8"
                            MinHeight="320" VerticalExpand="True" HorizontalExpand="True" />
                    </PanelContainer>
                    <PanelContainer StyleClasses="FishSurgeryReadout">
                        <Label Name="HoverName" ClipText="True" StyleClasses="FishSurgeryMuted"
                            Text="{Loc 'fish-surgery-hover-hint'}" Align="Center" />
                    </PanelContainer>
                    <Label Name="AdditionalPartsLabel" Text="{Loc 'fish-surgery-additional-parts'}"
                        StyleClasses="FishSurgeryCaption" Visible="False" />
                    <OptionButton Name="AdditionalParts" Visible="False" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10">
                <PanelContainer Name="AreaHeader" StyleClasses="FishSurgeryContextCard" Visible="False">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True">
                            <Label Text="{Loc 'fish-surgery-selected-area'}" StyleClasses="FishSurgeryCaption" />
                            <RichTextLabel Name="SelectedPart" StyleClasses="FishSurgeryContextTitle" />
                        </BoxContainer>
                        <PanelContainer Name="IncisionStatus" StyleClasses="FishSurgeryStatusIncision" Visible="False">
                            <Label Text="{Loc 'fish-surgery-incision-open'}" StyleClasses="FishSurgeryStatusIncisionText" />
                        </PanelContainer>
                        <PanelContainer Name="RetractionStatus" StyleClasses="FishSurgeryStatusRetraction" Visible="False">
                            <Label Text="{Loc 'fish-surgery-skin-retracted'}" StyleClasses="FishSurgeryStatusRetractionText" />
                        </PanelContainer>
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Button Name="PartsButton" Access="Public" StyleClasses="FishSurgeryButton" />
                    <Button Name="SurgeriesButton" Access="Public" StyleClasses="FishSurgeryButton" />
                    <Button Name="StepsButton" Access="Public" StyleClasses="FishSurgeryButton" />
                </BoxContainer>
                <PanelContainer StyleClasses="FishSurgeryWorkSurface" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical">
                        <PanelContainer StyleClasses="FishSurgeryStageHeader">
                            <Label Name="StageTitle" Margin="10 7" StyleClasses="FishSurgeryHeading" />
                        </PanelContainer>
                        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="10">
                                <RichTextLabel Name="EmptySelection" StyleClasses="FishSurgeryEmptyState"
                                    Text="{Loc 'fish-surgery-empty-selection'}" />
                                <RichTextLabel Name="NoOperations" StyleClasses="FishSurgeryEmptyState"
                                    Visible="False" Text="{Loc 'fish-surgery-no-operations'}" />
                                <BoxContainer Name="Surgeries" Access="Public" Orientation="Vertical"
                                    SeparationOverride="6" Visible="False" />
                                <BoxContainer Name="Steps" Access="Public" Orientation="Vertical"
                                    SeparationOverride="6" Visible="False" />
                            </BoxContainer>
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
                <Control Name="ConfirmationParking" Visible="False">
                    <!-- Совместимый контейнер для исходной реализации SurgeryBui; схема тела его не отображает. -->
                    <BoxContainer Name="Parts" Access="Public" />
                    <PanelContainer Name="ConfirmationPanel" StyleClasses="FishSurgeryDangerPanel" Visible="False">
                        <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="8">
                            <Label Text="{Loc 'fish-surgery-danger-heading'}" StyleClasses="FishSurgeryHeading" />
                            <RichTextLabel Name="ConfirmationText" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                <Button Name="CancelAction" Text="{Loc 'fish-surgery-cancel'}" StyleClasses="FishSurgeryButton" HorizontalExpand="True" />
                                <Button Name="ConfirmAction" Text="{Loc 'fish-surgery-confirm'}" StyleClasses="FishSurgeryDangerButton" HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                </Control>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
