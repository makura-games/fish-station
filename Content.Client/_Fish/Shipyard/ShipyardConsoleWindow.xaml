<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'shipyard-console-title'}"
                      MinSize="480 420"
                      SetSize="520 480">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <controls:StripeBack>
            <Label Text="{Loc 'shipyard-console-header'}"
                   Align="Center"
                   StyleClasses="LabelHeading"
                   Margin="4"/>
        </controls:StripeBack>

        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'shipyard-console-balance'}" StyleClasses="LabelKeyText"/>
            <Label Name="BalanceLabel" Text="0" Margin="8 0 0 0"/>
        </BoxContainer>

        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="VesselsContainer" Orientation="Vertical" SeparationOverride="8"/>
        </ScrollContainer>

        <Label Name="StatusLabel" Align="Center" Visible="False"/>
    </BoxContainer>
</controls:FancyWindow>
