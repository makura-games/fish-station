<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'skills-window-title'}"
                      MinSize="560 520"
                      SetSize="620 560">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <controls:StripeBack>
            <Label Name="HeaderLabel"
                   Align="Center"
                   StyleClasses="LabelHeading"
                   Margin="4"/>
        </controls:StripeBack>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Text="{Loc 'skills-window-points'}" StyleClasses="LabelKeyText"/>
            <Label Name="PointsLabel" Margin="4 0 0 0"/>
            <Control HorizontalExpand="True"/>
            <Label Name="LockedHintLabel" Visible="False" StyleClasses="status-warning"/>
        </BoxContainer>

        <Label Name="StatusLabel" Align="Center" Visible="False"/>

        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="SkillsContainer" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True"/>
        </ScrollContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="ResetButton"
                    Text="{Loc 'skills-window-reset'}"
                    HorizontalExpand="True"/>
            <Button Name="ConfirmButton"
                    Text="{Loc 'skills-window-confirm'}"
                    HorizontalExpand="True"
                    StyleClasses="Caution"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
