ent-FishXenoReaper = ксеноборг-рипер
    .desc = Гибрид машины и органического мозга, созданный для самовоспроизведения. Ксеноборги любят извлекать мозги, чтобы вставлять их в новые шасси и растить свою армию. Это модель «рипер» — скрытный диверсионный юнит, предназначенный для саботажа и убийств.
    .suffix = С мозгом, FISH
ent-FishXenoReaperPrinted = { ent-FishXenoReaper }
    .suffix = Без мозга, FISH
    .desc = { ent-FishXenoReaper.desc }
