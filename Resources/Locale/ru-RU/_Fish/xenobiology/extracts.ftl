fish-slime-extract-examine-uses = Осталось использований: {$uses}/{$max}.
fish-slime-extract-used-name = использованный экстракт слайма
fish-slime-extract-used-desc = Это ядро уже истрачено.
fish-slime-extract-enhanced = Вы наносите усилитель. Ядро можно использовать ещё раз.
fish-slime-extract-enhance-full = Это ядро нельзя усилить сильнее!
fish-slime-extract-react = Раствор начинает пузыриться.
fish-slime-extract-spent = Сила {THE($extract)} уходит в реакцию.
fish-slime-extract-gold-cap = От золотых экстрактов уже слишком много критов на станции!
fish-slime-extract-gold-pending = Экстракт начинает вибрировать — через несколько секунд что-то появится.

ent-FishSlimeExtractBase = экстракт слайма
    .desc = Слизь, добытая из слайма. Легенды приписывают ей странные силы.
    .suffix = Fish

ent-FishSlimeExtractGrey = серый экстракт слайма
    .desc = Серое ядро слайма. Плазма, вода и кровь делают с ним разное.
    .suffix = Fish

ent-FishSlimeExtractOrange = оранжевый экстракт слайма
    .desc = Оранжевое ядро слайма. Отвечает на кровь и плазму.
    .suffix = Fish

ent-FishSlimeExtractMetal = металлический экстракт слайма
    .desc = Металлическое ядро слайма. Слабо пахнет сталью.
    .suffix = Fish

ent-FishSlimeExtractBlue = синий экстракт слайма
    .desc = Синее ядро слайма, холодное на ощупь.
    .suffix = Fish

ent-FishSlimeExtractPurple = фиолетовый экстракт слайма
    .desc = Фиолетовое ядро слайма. И сахар, и плазма его будят.
    .suffix = Fish

ent-FishSlimeExtractDarkPurple = тёмно-фиолетовый экстракт слайма
    .desc = Тёмно-фиолетовое ядро слайма. Из него выходят листы плазмы.
    .suffix = Fish

ent-FishSlimeExtractDarkBlue = тёмно-синий экстракт слайма
    .desc = Тёмно-синее ядро слайма. На плазме выстуживает воздух вокруг.
    .suffix = Fish

ent-FishSlimeExtractGreen = зелёный экстракт слайма
    .desc = Зелёное ядро слайма. Плазма превращается в токсин мутации.
    .suffix = Fish

ent-FishSlimeExtractSilver = серебряный экстракт слайма
    .desc = Серебряное ядро слайма. Вызывает еду и напитки.
    .suffix = Fish

ent-FishSlimeExtractYellow = жёлтый экстракт слайма
    .desc = Жёлтое ядро слайма. Кровь заставляет его визжать электричеством.
    .suffix = Fish

ent-FishSlimeExtractGold = золотой экстракт слайма
    .desc = Золотое ядро слайма. Вибрирует, когда вот-вот кого-то позовёт.
    .suffix = Fish

ent-FishSlimeExtractPink = розовый экстракт слайма
    .desc = Розовое ядро слайма. Успокаивает слаймов или даёт омнизин.
    .suffix = Fish

ent-FishSlimeExtractRed = красный экстракт слайма
    .desc = Красное ядро слайма. Плазма, кровь и вода тянут разные трюки.
    .suffix = Fish

ent-FishSlimeExtractOil = нефтяной экстракт слайма
    .desc = Нефтяное ядро слайма. От плазмы трясётся. Отойдите.
    .suffix = Fish

ent-FishSlimeExtractLightPink = светло-розовый экстракт слайма
    .desc = Светло-розовое ядро слайма. Плазма выращивает зелье разума.
    .suffix = Fish

ent-FishSlimeExtractBlack = чёрный экстракт слайма
    .desc = Чёрное ядро слайма. Плазма даёт продвинутый токсин мутации.
    .suffix = Fish

ent-FishSlimeExtractAdamantine = адамантиновый экстракт слайма
    .desc = Адамантиновое ядро слайма. Плазма сгущается в лист металла.
    .suffix = Fish

ent-FishSlimeExtractBluespace = блюспейс экстракт слайма
    .desc = Блюспейс-ядро слайма. Кровь стелет плитку, плазма — кристалл.
    .suffix = Fish

ent-FishSlimeExtractCerulean = лазурный экстракт слайма
    .desc = Лазурное ядро слайма. Плазма усиливает ядра. Кровь метит территорию.
    .suffix = Fish

ent-FishSlimeExtractSepia = сепия экстракт слайма
    .desc = Ядро слайма цвета сепии. Время, камеры и медленные полы.
    .suffix = Fish

ent-FishSlimeExtractPyrite = пиритовый экстракт слайма
    .desc = Пиритовое ядро слайма. Плазма выбирает случайную банку краски.
    .suffix = Fish

ent-FishSlimeExtractRainbow = радужный экстракт слайма
    .desc = Радужное ядро слайма. Плазма рождает случайного слайма. Кровь — зелье переноса.
    .suffix = Fish

ent-FishXenobiologyBluespaceTileFish = плитка блюспейс-пола
    .desc = Плитка пола со странным трением. Укладывается как сепия.
    .suffix = Fish
