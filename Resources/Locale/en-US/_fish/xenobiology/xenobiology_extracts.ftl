ent-FishXenoSerumMutation = mutation serum
    .desc = Apply directly to a living laboratory slime. Increases inherited mutation probability by 10 percentage points, up to 100%.
    .suffix = Fish

ent-FishXenoSerumStability = stability serum
    .desc = Apply directly to a living laboratory slime. Decreases inherited mutation probability by 10 percentage points, down to 0%.
    .suffix = Fish

ent-FishXenoSerumGrowth = growth serum
    .desc = Apply directly to a living laboratory slime. Increases inherited growth speed by 15 percentage points, up to twice the normal rate.
    .suffix = Fish

ent-FishXenoSerumYield = yield serum
    .desc = Apply directly to a living laboratory slime. Increases inherited adult extract yield by one, up to three extracts.
    .suffix = Fish

ent-FishXenoSerumFertility = fertility serum
    .desc = Apply directly to a living laboratory slime. Increases inherited offspring count by one, up to four juveniles per division.
    .suffix = Fish

ent-FishXenoSerumDocility = docility serum
    .desc = Apply directly to a living laboratory slime. Increases inherited docility by 25 percentage points, up to 100%.
    .suffix = Fish

ent-FishXenoSerumThermal = thermal tolerance serum
    .desc = Apply directly to a living laboratory slime. Widens the inherited comfortable temperature range by 5 K on either side, up to 20 K.
    .suffix = Fish

ent-FishXenoSampleBottle = xenobiology sample
    .desc = A reagent sample produced by a slime extract. Check its contents before use.
    .suffix = Fish

ent-FishXenoPowerCell = bioelectric power cell
    .desc = A 720-joule power cell grown from a yellow slime extract. It has no self-charging mechanism.
    .suffix = Fish

