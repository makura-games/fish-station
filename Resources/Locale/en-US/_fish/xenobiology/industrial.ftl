research-technology-fish-industrial-xenobiology = Industrial xenobiology
    .suffix = Fish
fish-research-technology-fish-industrial-xenobiology-description = Single-use induction catalysts for transforming an adult laboratory slime with ten unused same-breed extracts into a reusable, plasma-fueled industrial extract.

ent-FishXenoIndustrialCatalyst = industrial induction catalyst
    .desc = A sealed catalyst for industrial slime induction. Its label specifies one living adult laboratory slime and ten unused extracts of the same breed.
    .suffix = Fish
ent-FishXenoIndustrialExtractBase = industrial slime extract
    .desc = A dense industrial slime core. Its label specifies liquid plasma and uninterrupted operation on a floor outside containers.
    .suffix = Fish
ent-FishXenoIndustrialExtractMetal = industrial metal extract
    .desc = { ent-FishXenoIndustrialExtractBase.desc }
    .suffix = Fish
ent-FishXenoIndustrialExtractYellow = industrial yellow extract
    .desc = { ent-FishXenoIndustrialExtractBase.desc }
    .suffix = Fish
ent-FishXenoIndustrialExtractPurple = industrial purple extract
    .desc = { ent-FishXenoIndustrialExtractBase.desc }
    .suffix = Fish
ent-FishXenoIndustrialExtractSilver = industrial silver extract
    .desc = { ent-FishXenoIndustrialExtractBase.desc }
    .suffix = Fish
ent-FishXenoIndustrialExtractBlue = industrial blue extract
    .desc = { ent-FishXenoIndustrialExtractBase.desc }
    .suffix = Fish

fish-xeno-industrial-access = Hold the item, stand within reach and make sure you can interact.
fish-xeno-industrial-specimen = Industrial induction requires a living, uncontained adult NPC laboratory slime.
fish-xeno-industrial-already-induced = This specimen is already undergoing industrial induction.
fish-xeno-industrial-unsupported = This breed has no industrial recipe.
fish-xeno-industrial-unused = Only unused ordinary extracts can be fed to the specimen.
fish-xeno-industrial-breed = The ordinary extract must match the induced specimen's breed.
fish-xeno-industrial-induced = Induction started. Feed it { $required } unused ordinary extracts of its own breed.
fish-xeno-industrial-progress = Industrial induction: { $current }/{ $required } unused { $breed } extracts consumed. Division and corpse extraction are blocked.
fish-xeno-industrial-cycle = Each batch consumes { $plasma } units of liquid plasma after { $seconds } uninterrupted seconds on a non-space floor outside all containers and hands.
fish-xeno-industrial-product = Batch output: { $count } × { $name }.
fish-xeno-industrial-running = Fueled and correctly placed. Moving it into a container or pausing interrupts the cycle; production restarts with a full cycle.
fish-xeno-industrial-stopped = Production stopped. Supply enough liquid plasma and place the extract on a real floor outside containers and hands.
fish-xeno-industrial-heading = Industrial induction
fish-xeno-industrial-catalog = Research Industrial xenobiology (tier 3 Biochemical, 15000 points; requires Colony engineering and Industrial engineering), then print an industrial induction catalyst in the protolathe. Apply the held, single-use catalyst to a living adult NPC laboratory slime of this breed, then feed it { $required } unused ordinary extracts of the same breed, one at a time. This consumes the adult and creates one reusable industrial extract; induced specimens cannot divide or be processed for ordinary extracts.
