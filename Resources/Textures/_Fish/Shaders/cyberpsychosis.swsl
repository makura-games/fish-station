light_mode unshaded;

// Experimental cyberpsychosis fullscreen shader.
// 10%-25%: subtle, very fine horizontal micro-glitch strips sampling nearby screen fragments.
// 25%-90%: larger horizontal displaced fragments in the vignette + Noir red-only desaturation + 3D-glasses cyan/red lateral split.

uniform sampler2D SCREEN_TEXTURE;
uniform highp float Level;
uniform highp float PreserveVisor;

const highp float RedHueRange = 5.0;
const highp float MinSaturation = 0.4;

highp vec3 rgb2hsv(highp vec3 c) {
    highp float xMax = max(c.r, max(c.g, c.b));
    highp float xMin = min(c.r, min(c.g, c.b));
    highp float delta = xMax - xMin;

    highp float hue = 0.0;
    if (delta > 0.0) {
        if (xMax == c.r) {
            hue = mod((c.g - c.b) / delta, 6.0);
        } else if (xMax == c.g) {
            hue = (c.b - c.r) / delta + 2.0;
        } else {
            hue = (c.r - c.g) / delta + 4.0;
        }
        hue *= 60.0;
        if (hue < 0.0) hue += 360.0;
    }

    highp float sat = (xMax == 0.0) ? 0.0 : delta / xMax;
    return vec3(hue, sat, xMax);
}

highp vec3 applyNoir(highp vec3 c, highp float desatWeight) {
    if (desatWeight <= 0.0)
        return c;

    highp vec3 gray = vec3(zGrayscale(c));
    highp vec3 hsv = rgb2hsv(c);
    bool is_red = hsv.x < RedHueRange || hsv.x > (360.0 - RedHueRange);
    bool is_visor_cyan = PreserveVisor > 0.5 && hsv.x > 180.0 && hsv.x < 210.0 && hsv.y > 0.6;
    bool saturated_enough = hsv.y > MinSaturation;

    if ((is_red && saturated_enough) || is_visor_cyan)
        return c;

    return mix(c, gray, desatWeight);
}

void fragment() {
    // Overall ramp: 0.0 at 10% -> 1.0 at 90% (drives fine glitch size, count, and shift smoothly from zero).
    highp float overall = clamp((Level - 0.10) / 0.80, 0.0, 1.0);
    // Stage 2: 25% -> 90% ramps larger vignette horizontal fragments, Noir desaturation, and 3D cyan/red split.
    highp float stage2 = clamp((Level - 0.25) / 0.65, 0.0, 1.0);

    highp vec2 centered = (UV - vec2(0.5)) * vec2(1.3, 1.0);
    highp float vignette = smoothstep(0.28, 0.90, length(centered));
    highp float sideMask = smoothstep(0.18, 0.88, abs(UV.x - 0.5) * 2.0);

    // Stepped time for crisp horizontal glitch snaps.
    highp float tStep = floor(TIME * 9.0) * 0.173;
    highp float tFast = floor(TIME * 16.0) * 0.097;

    // Layer 1: horizontal strips across the whole screen; size, count, and displacement scale from 0 at 10% to full at 90%.
    highp vec2 fineGrid = mix(vec2(38.0, 320.0), vec2(14.0, 140.0), overall);
    highp vec2 fineCell = floor(UV * fineGrid);
    highp float fineRand = zRandom(fineCell * 0.037 + vec2(tFast, tStep)).x;
    highp float fineDensity = pow(overall, 1.35) * (0.14 + 0.055 * vignette);
    highp float fineTrigger = step(1.0 - fineDensity, fineRand);
    highp vec2 fineOffset = vec2(
        (fract(fineRand * 19.3) - 0.5) * (0.080 * overall),
        (fract(fineRand * 7.1) - 0.5) * (0.018 * overall)
    ) * fineTrigger;

    // Layer 2: larger horizontal displaced fragments growing in the vignette during stage 2.
    highp vec2 bigCell = vec2(floor(UV.x * 7.0), floor(UV.y * 42.0));
    highp float bigRand = zRandom(bigCell * 0.053 + vec2(tStep, tStep * 0.43)).x;
    highp float bigTrigger = step(0.968 - stage2 * vignette * 0.20, bigRand) * step(0.15, vignette);
    highp vec2 bigOffset = vec2(
        (fract(bigRand * 13.7) - 0.5) * 0.085 * stage2 * vignette,
        (fract(bigRand * 5.3) - 0.5) * 0.014 * stage2 * vignette
    ) * bigTrigger;

    highp vec2 sampleUv = clamp(UV + fineOffset + bigOffset, vec2(0.001), vec2(0.999));
    highp float desatWeight = stage2 > 0.0
        ? clamp(stage2 * (0.45 + 0.55 * vignette) + stage2 * stage2 * 0.55, 0.0, 1.0)
        : 0.0;

    highp vec4 baseSample = zTextureSpec(SCREEN_TEXTURE, sampleUv);

    if (stage2 <= 0.0) {
        if (fineTrigger <= 0.0) {
            COLOR = baseSample;
            return;
        }
        // Subtle 3D cyan/red shift on triggered micro-strips scaling cleanly from 0 at 10%.
        highp float fineSplit = 0.0035 * overall;
        highp float rFine = zTextureSpec(SCREEN_TEXTURE, clamp(sampleUv + vec2(fineSplit, 0.0), vec2(0.001), vec2(0.999))).r;
        highp vec2 gbFine = zTextureSpec(SCREEN_TEXTURE, clamp(sampleUv - vec2(fineSplit, 0.0), vec2(0.001), vec2(0.999))).gb;
        COLOR = vec4(rFine, gbFine.x, gbFine.y, baseSample.a);
        return;
    }

    // True 3D-glasses anaglyph lateral split (red right, cyan left) growing along sides and active glitch strips.
    highp float activeGlitch = max(fineTrigger, bigTrigger);
    highp float anaglyph = stage2 * 0.008 * max(vignette, sideMask * 0.85)
        + (0.0035 * overall + 0.0065 * stage2) * activeGlitch;

    highp vec3 redSide = applyNoir(
        zTextureSpec(SCREEN_TEXTURE, clamp(sampleUv + vec2(anaglyph, 0.0), vec2(0.001), vec2(0.999))).rgb,
        desatWeight
    );
    highp vec3 cyanSide = applyNoir(
        zTextureSpec(SCREEN_TEXTURE, clamp(sampleUv - vec2(anaglyph, 0.0), vec2(0.001), vec2(0.999))).rgb,
        desatWeight
    );

    highp vec3 result = vec3(redSide.r, cyanSide.g, cyanSide.b);

    // Stage 3: 90% -> 100% adds a classic dark vignette around the screen edges.
    highp float stage3 = clamp((Level - 0.90) / 0.10, 0.0, 1.0);
    result *= 1.0 - stage3 * vignette * 0.72;

    COLOR = vec4(result, baseSample.a);
}
