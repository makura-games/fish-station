light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float intensity;
uniform highp float time;
uniform highp vec2 screen_size;

highp vec4 sampleScreen(highp vec2 uv)
{
    return zTextureSpec(SCREEN_TEXTURE, clamp(uv, vec2(0.0), vec2(1.0)));
}

void fragment()
{
    highp float strength = clamp(intensity, 0.0, 1.0);
    highp vec2 texel = vec2(1.0) / max(screen_size, vec2(1.0));

    highp vec2 uv = UV;
    uv.x += sin(uv.y * 26.0 + time * 2.4) * 0.0012 * strength;
    uv.y += cos(uv.x * 21.0 - time * 1.9) * 0.0012 * strength;
    uv = clamp(uv, vec2(0.0), vec2(1.0));

    highp vec4 color = sampleScreen(uv);

    // Резкость через unsharp mask.
    highp vec4 blur = sampleScreen(uv + vec2(texel.x, 0.0))
        + sampleScreen(uv - vec2(texel.x, 0.0))
        + sampleScreen(uv + vec2(0.0, texel.y))
        + sampleScreen(uv - vec2(0.0, texel.y));
    blur *= 0.25;
    highp float sharpen = 1.0 + strength * 1.35;
    color.rgb = color.rgb * sharpen - blur.rgb * (sharpen - 1.0);

    // Хроматические сдвиги, подчёркивающие края.
    highp float aberration = 0.0015 + strength * 0.0045;
    highp vec4 redSample = sampleScreen(uv + vec2(aberration, 0.0));
    highp vec4 greenSample = sampleScreen(uv + vec2(-aberration, aberration * 0.4));
    highp vec4 blueSample = sampleScreen(uv - vec2(aberration, 0.0));
    color.r = mix(color.r, redSample.r, strength * 0.55);
    color.g = mix(color.g, greenSample.g, strength * 0.50);
    color.b = mix(color.b, blueSample.b, strength * 0.25);

    // Насыщенность без ухода в серость.
    highp float luminance = dot(color.rgb, vec3(0.299, 0.587, 0.114));
    color.rgb = mix(vec3(luminance), color.rgb, 1.0 + strength * 0.85);

    // Красный и зелёный выражены сильнее, синий сохраняется.
    color.r *= 1.0 + strength * 0.22;
    color.g *= 1.0 + strength * 0.30;
    color.b *= 1.0 + strength * 0.08;

    // Осветление вместо затемнения.
    color.rgb = color.rgb * (1.0 + strength * 0.16) + vec3(0.035 * strength);

    // Умеренный контраст.
    color.rgb = (color.rgb - 0.5) * (1.0 + strength * 0.30) + 0.5;

    COLOR = clamp(color, 0.0, 1.0);
}
