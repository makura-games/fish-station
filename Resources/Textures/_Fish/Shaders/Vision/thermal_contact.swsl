light_mode unshaded;
uniform highp float activation;
uniform highp float glow_width;

void fragment() {
    highp vec4 source = zTexture(UV);
    highp vec2 step = TEXTURE_PIXEL_SIZE * glow_width;
    highp float near_alpha = 0.0;
    highp float far_alpha = 0.0;
    // Свечение повторяет альфа-контур готового спрайта, а не геометрическую заготовку.
    for (highp int y = -1; y <= 1; y++) {
        for (highp int x = -1; x <= 1; x++) {
            highp vec2 offset = vec2(float(x), float(y)) * step;
            near_alpha += zTexture(UV + offset).a / 9.0;
            far_alpha += zTexture(UV + offset * 3.5).a / 9.0;
        }
    }
    highp vec3 original = source.rgb / max(source.a, 0.001);
    highp float detail = clamp(dot(original, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
    highp float interior = smoothstep(0.55, 0.98, far_alpha);
    // Цвет вершины уже содержит измеренную температуру. Холодные цели сохраняют синюю палитру.
    highp float warmth = smoothstep(0.0, 0.12, MODULATE.r - MODULATE.b);
    // Рисунок одежды лишь слегка меняет яркость: чёрная ткань не делает тёплое тело холодным.
    highp float core = interior * (0.85 + 0.15 * sqrt(detail));
    highp vec3 warm_heat = mix(vec3(1.0, 0.70, 0.01), vec3(1.0), core);
    highp vec3 heat = mix(vec3(0.85 + 0.15 * sqrt(detail)), warm_heat, warmth);
    highp float body = source.a;
    highp float halo = (near_alpha * 0.28 + far_alpha * 0.12) * (1.0 - body);
    highp float alpha = clamp(body + halo, 0.0, 1.0) * activation;
    // Температурный цвет и прозрачность применяются штатным MODULATE после fragment().
    highp vec3 halo_color = mix(vec3(1.0), vec3(1.0, 0.70, 0.01), warmth);
    highp vec3 color = mix(halo_color, heat, body);
    COLOR = vec4(color, alpha);
}
