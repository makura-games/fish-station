light_mode unshaded;
blend_mode none;
uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D EXPOSURE_TEXTURE;
uniform highp float activation;

void fragment() {
    highp vec4 original = zTextureSpec(SCREEN_TEXTURE, UV);
    highp float gray = dot(original.rgb, vec3(0.2126, 0.7152, 0.0722));
    // Чёрный остаётся чёрным: палитра не высветляет скрытое пространство.
    highp vec3 blue = vec3(0.035, 0.025, 0.27);
    highp vec3 purple = vec3(0.40, 0.025, 0.58);
    highp vec3 cold = mix(blue, purple, smoothstep(0.08, 0.8, gray)) * smoothstep(0.0, 0.25, gray);
    highp float gain = texture2D(EXPOSURE_TEXTURE, vec2(0.5)).r;
    // Эллипс привязан к окну, а не к миру: центр прозрачен, углы затемняются максимум на 16%.
    highp float radius = length(UV * 2.0 - 1.0);
    highp float vignette = 1.0 - 0.16 * smoothstep(0.45, 1.35, radius);
    cold *= gain * vignette;
    COLOR = vec4(mix(original.rgb, cold, activation), original.a);
}
